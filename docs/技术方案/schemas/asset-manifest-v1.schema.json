{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ecommerce-detail.invalid/schemas/asset-manifest-v1.schema.json",
  "title": "Batch asset manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_id", "batch_id", "input_type", "template_snapshot",
    "styles", "assets", "inventory_digest", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "asset-manifest/v1" },
    "manifest_id": { "$ref": "#/$defs/id" },
    "batch_id": { "$ref": "#/$defs/id" },
    "input_type": { "enum": ["single_style", "style_directory_batch"] },
    "template_snapshot": { "$ref": "#/$defs/templateSnapshot" },
    "styles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/style" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/asset" }
    },
    "inventory_digest": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32767,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:)[^\\u0000]+$"
    },
    "relativeDirectory": {
      "type": "string",
      "maxLength": 32767,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*:)[^\\u0000]*$"
    },
    "templateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "revision_id", "rules_digest", "selected_page_ids"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/id" },
        "revision_id": { "$ref": "#/$defs/id" },
        "rules_digest": {
          "type": "string",
          "pattern": "^(?:sha256:)?[0-9a-f]{64}$"
        },
        "selected_page_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_id", "default_sku", "source_relative_directory", "order", "asset_ids"],
      "properties": {
        "style_id": { "$ref": "#/$defs/id" },
        "default_sku": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_relative_directory": { "$ref": "#/$defs/relativeDirectory" },
        "order": { "type": "integer", "minimum": 0, "maximum": 199 },
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id", "style_id", "source_relative_path", "file_name", "length",
        "sha256", "pixel_width", "pixel_height", "format", "mime_type", "readability"
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/id" },
        "style_id": { "$ref": "#/$defs/id" },
        "source_relative_path": { "$ref": "#/$defs/relativePath" },
        "file_name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "length": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pixel_width": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "pixel_height": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "format": { "enum": ["jpeg", "png", "tiff"] },
        "mime_type": { "enum": ["image/jpeg", "image/png", "image/tiff"] },
        "readability": { "const": "readable" }
      }
    }
  }
}
