{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ecommerce-detail.invalid/schemas/ai-analysis-v1.schema.json",
  "title": "AI analysis contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_kind"],
  "properties": {
    "schema_version": { "enum": ["ai-analysis/v1", "ai-analysis-result/v1"] },
    "document_kind": { "enum": ["request", "result"] },
    "request_id": { "$ref": "#/$defs/id" },
    "correlation_id": { "$ref": "#/$defs/id" },
    "product_id": { "$ref": "#/$defs/id" },
    "batch_id": { "$ref": "#/$defs/id" },
    "style_id": { "$ref": "#/$defs/id" },
    "template_snapshot_id": { "$ref": "#/$defs/id" },
    "template_revision_id": { "$ref": "#/$defs/id" },
    "analysis_kind": { "enum": ["product_joint_understanding", "selected_asset_geometry", "size_table_extraction"] },
    "model_config_version": { "$ref": "#/$defs/version" },
    "prompt_contract_version": { "$ref": "#/$defs/version" },
    "response_schema_version": { "const": "ai-analysis-result/v1" },
    "compression_profile_version": { "$ref": "#/$defs/version" },
    "consent_id": { "$ref": "#/$defs/id" },
    "requirements_digest": { "$ref": "#/$defs/digest" },
    "assets": { "type": "array", "minItems": 1, "maxItems": 20000, "items": { "$ref": "#/$defs/asset" } },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "#/$defs/requirement" } },
    "provider_request_ref": { "type": ["string", "null"], "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]*$" },
    "requirement_matches": { "type": "array", "maxItems": 40000, "items": { "$ref": "#/$defs/match" } },
    "variant_groups": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/variant" } },
    "subject_geometry": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/geometry" } },
    "size_table_candidate": { "anyOf": [{ "$ref": "#/$defs/sizeTable" }, { "type": "null" }] },
    "warnings": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/warning" } },
    "usage": { "$ref": "#/$defs/usage" }
  },
  "allOf": [
    { "if": { "properties": { "document_kind": { "const": "request" } } }, "then": { "required": ["schema_version", "request_id", "correlation_id", "product_id", "batch_id", "style_id", "template_snapshot_id", "template_revision_id", "analysis_kind", "model_config_version", "prompt_contract_version", "response_schema_version", "compression_profile_version", "consent_id", "requirements_digest", "assets", "requirements"] } },
    { "if": { "properties": { "document_kind": { "const": "result" } } }, "then": { "required": ["schema_version", "request_id", "model_config_version", "requirement_matches", "variant_groups", "subject_geometry", "size_table_candidate", "warnings", "usage"] } },
    { "if": { "properties": { "document_kind": { "const": "request" } } }, "then": { "properties": { "schema_version": { "const": "ai-analysis/v1" } } } },
    { "if": { "properties": { "document_kind": { "const": "result" } } }, "then": { "properties": { "schema_version": { "const": "ai-analysis-result/v1" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._/-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "asset": { "type": "object", "additionalProperties": false, "required": ["asset_id", "content_hash", "mime_type", "pixel_width", "pixel_height", "analysis_copy_ref"], "properties": { "asset_id": { "$ref": "#/$defs/id" }, "content_hash": { "$ref": "#/$defs/digest" }, "mime_type": { "enum": ["image/jpeg", "image/png", "image/tiff"] }, "pixel_width": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "pixel_height": { "type": "integer", "minimum": 1, "maximum": 1000000 }, "analysis_copy_ref": { "$ref": "#/$defs/id" }, "analysis_copy_digest": { "$ref": "#/$defs/digest" }, "analysis_copy_length": { "type": "integer", "minimum": 1, "maximum": 67108864 }, "analysis_copy_mime_type": { "enum": ["image/jpeg", "image/png", "image/tiff"] }, "analysis_copy_compression_profile": { "$ref": "#/$defs/version" }, "analysis_copy_lease_id": { "$ref": "#/$defs/id" } } },
    "requirement": { "type": "object", "additionalProperties": false, "required": ["requirement_id", "selection_requirement", "layout_intent", "required"], "properties": { "requirement_id": { "$ref": "#/$defs/id" }, "selection_requirement": { "type": "string", "minLength": 1, "maxLength": 2000 }, "layout_intent": { "type": "string", "minLength": 1, "maxLength": 1000 }, "required": { "type": "boolean" } } },
    "match": { "type": "object", "additionalProperties": false, "required": ["requirement_id", "asset_id", "rank", "confidence", "evidence_codes"], "properties": { "requirement_id": { "$ref": "#/$defs/id" }, "asset_id": { "$ref": "#/$defs/id" }, "rank": { "type": "integer", "minimum": 1, "maximum": 20000 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence_codes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "variant": { "type": "object", "additionalProperties": false, "required": ["variant_id", "dimension", "value", "asset_ids", "is_primary_suggestion"], "properties": { "variant_id": { "$ref": "#/$defs/id" }, "dimension": { "type": "string", "minLength": 1, "maxLength": 200 }, "value": { "type": "string", "minLength": 1, "maxLength": 200 }, "asset_ids": { "type": "array", "minItems": 1, "maxItems": 20000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "is_primary_suggestion": { "type": "boolean" }, "variant_role": { "type": ["string", "null"], "enum": ["primary", "secondary", null] }, "coverage_requirement_ids": { "type": ["array", "null"], "maxItems": 20000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "missing_requirement_ids": { "type": ["array", "null"], "maxItems": 20000, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "is_complete": { "type": ["boolean", "null"] }, "evidence_codes": { "type": ["array", "null"], "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "primary_suggestion_evidence": { "type": ["string", "null"], "maxLength": 500 } } },
    "geometry": { "type": "object", "additionalProperties": false, "required": ["asset_id", "left", "top", "right", "bottom", "confidence"], "properties": { "asset_id": { "$ref": "#/$defs/id" }, "left": { "type": "number", "minimum": 0, "maximum": 1 }, "top": { "type": "number", "minimum": 0, "maximum": 1 }, "right": { "type": "number", "minimum": 0, "maximum": 1 }, "bottom": { "type": "number", "minimum": 0, "maximum": 1 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "sizeTable": { "type": "object", "additionalProperties": false, "required": ["source_asset_id", "confidence", "columns", "rows"], "properties": { "source_asset_id": { "$ref": "#/$defs/id" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "columns": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }, "rows": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "maxLength": 500 } } } } },
    "warning": { "type": "object", "additionalProperties": false, "required": ["code", "scope", "message_summary"], "properties": { "code": { "$ref": "#/$defs/id" }, "scope": { "enum": ["request", "product", "requirement", "asset", "size_table"] }, "message_summary": { "type": "string", "minLength": 1, "maxLength": 500 } } },
    "usage": { "type": "object", "additionalProperties": false, "required": ["usage_event_id", "input_units", "output_units", "request_count"], "properties": { "usage_event_id": { "$ref": "#/$defs/id" }, "input_units": { "type": "integer", "minimum": 0 }, "output_units": { "type": "integer", "minimum": 0 }, "request_count": { "type": "integer", "minimum": 1 }, "provider_cost_amount": { "type": ["number", "null"], "minimum": 0 }, "provider_cost_currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" } } }
  }
}
