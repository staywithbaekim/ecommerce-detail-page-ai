{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/ecommerce-detail/contracts/ps-bridge/v1",
  "title": "Photoshop loopback bridge v1",
  "description": "Machine-readable envelope and endpoint payload contract. Secrets and filesystem paths are intentionally opaque.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "envelope_kind", "body"],
  "properties": {
    "protocol_version": { "const": "ps-bridge/v1" },
    "envelope_kind": { "enum": ["handshake_request", "handshake_response", "request", "response", "event"] },
    "body": {
      "oneOf": [
        { "$ref": "#/$defs/handshakeRequest" },
        { "$ref": "#/$defs/handshakeResponse" },
        { "$ref": "#/$defs/requestEnvelope" },
        { "$ref": "#/$defs/responseEnvelope" },
        { "$ref": "#/$defs/eventEnvelope" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "envelope_kind": { "const": "handshake_request" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/handshakeRequest" } } }
    },
    {
      "if": { "properties": { "envelope_kind": { "const": "handshake_response" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/handshakeResponse" } } }
    },
    {
      "if": { "properties": { "envelope_kind": { "const": "request" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/requestEnvelope" } } }
    },
    {
      "if": { "properties": { "envelope_kind": { "const": "response" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/responseEnvelope" } } }
    },
    {
      "if": { "properties": { "envelope_kind": { "const": "event" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/eventEnvelope" } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,199}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "base64url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 16,
      "maxLength": 512
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43,512}$"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "scope", "user_action"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^BRIDGE_[A-Z0-9_]{2,80}$"
        },
        "retryable": { "type": "boolean" },
        "scope": { "enum": ["request", "execution", "session", "host"] },
        "user_action": { "type": "string", "minLength": 1, "maxLength": 256 },
        "details": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": ["string", "integer", "boolean", "null"],
            "maxLength": 512
          }
        }
      }
    },
    "clientInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app_version", "protocol_version"],
      "properties": {
        "app_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "protocol_version": { "const": "ps-bridge/v1" },
        "requested_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$" }
        }
      }
    },
    "hostInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_manifest_version", "photoshop_build"],
      "properties": {
        "plugin_manifest_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "photoshop_build": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uxp_runtime_version": { "type": "string", "maxLength": 64 }
      }
    },
    "handshakeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "correlation_id", "sent_at", "session_id", "nonce", "client", "host", "pairing_proof"],
      "properties": {
        "request_id": { "$ref": "#/$defs/requestId" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "sent_at": { "$ref": "#/$defs/dateTime" },
        "session_id": { "$ref": "#/$defs/id" },
        "nonce": { "$ref": "#/$defs/nonce" },
        "client": { "$ref": "#/$defs/clientInfo" },
        "host": { "$ref": "#/$defs/hostInfo" },
        "pairing_proof": { "$ref": "#/$defs/base64url" }
      }
    },
    "handshakeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "request_id", "correlation_id", "status", "server_time"],
      "properties": {
        "ok": { "type": "boolean" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["paired", "rejected"] },
        "server_time": { "$ref": "#/$defs/dateTime" },
        "session_id": { "$ref": "#/$defs/id" },
        "execution_port": { "type": "integer", "minimum": 49152, "maximum": 65535 },
        "token": { "$ref": "#/$defs/token" },
        "expires_at": { "$ref": "#/$defs/dateTime" },
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$" }
        },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "paired" } } },
          "then": { "required": ["session_id", "execution_port", "token", "expires_at", "capabilities"], "properties": { "ok": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } } },
          "then": { "required": ["error"], "properties": { "ok": { "const": false } } }
        }
      ]
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "session_handle", "sha256", "purpose", "read_only"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/id" },
        "session_handle": { "$ref": "#/$defs/base64url" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "purpose": { "enum": ["template_copy", "high_resolution_render_source", "deterministic_size_table"] },
        "read_only": { "const": true },
        "byte_length": { "type": "integer", "minimum": 1, "maximum": 2147483648 }
      }
    },
    "outputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_set_id", "output_root_handle", "overwrite_policy", "confirmed_target_ids"],
      "properties": {
        "artifact_set_id": { "$ref": "#/$defs/id" },
        "output_root_handle": { "$ref": "#/$defs/base64url" },
        "overwrite_policy": { "enum": ["never", "confirmed_targets_only"] },
        "confirmed_target_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "planPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_scope", "render_plan", "plan_digest", "resource_bindings", "output_bindings"],
      "properties": {
        "execution_scope": { "enum": ["page", "product"] },
        "render_plan": { "type": "object", "maxProperties": 64 },
        "plan_digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
        "resource_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/resourceBinding" }
        },
        "output_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/outputBinding" }
        }
      }
    },
    "cancelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": { "reason": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "heartbeatPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_state", "modal_state", "last_event_seq"],
      "properties": {
        "host_state": { "enum": ["ready", "busy", "blocked", "unknown"] },
        "modal_state": { "enum": ["idle", "running", "waiting_boundary", "unknown"] },
        "last_event_seq": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "requestEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "correlation_id", "session_id", "token", "sent_at", "idempotency_key", "operation", "payload"],
      "properties": {
        "request_id": { "$ref": "#/$defs/requestId" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "session_id": { "$ref": "#/$defs/id" },
        "token": { "$ref": "#/$defs/token" },
        "sent_at": { "$ref": "#/$defs/dateTime" },
        "idempotency_key": { "$ref": "#/$defs/idempotencyKey" },
        "operation": { "enum": ["submit_plan", "get_execution", "cancel_execution", "heartbeat", "release"] },
        "execution_id": { "$ref": "#/$defs/id" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/planPayload" },
            { "$ref": "#/$defs/cancelPayload" },
            { "$ref": "#/$defs/heartbeatPayload" },
            { "type": "object", "maxProperties": 0 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "submit_plan" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/planPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "get_execution" } } },
          "then": {
            "required": ["execution_id"],
            "properties": { "payload": { "type": "object", "maxProperties": 0 } }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "cancel_execution" } } },
          "then": {
            "required": ["execution_id"],
            "properties": { "payload": { "$ref": "#/$defs/cancelPayload" } }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "heartbeat" } } },
          "then": { "properties": { "payload": { "$ref": "#/$defs/heartbeatPayload" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "release" } } },
          "then": { "properties": { "payload": { "type": "object", "maxProperties": 0 } } }
        }
      ]
    },
    "executionStatus": {
      "type": "string",
      "enum": ["accepted", "running", "pause_pending", "paused", "completed", "failed", "cancel_pending", "cancelled", "unknown"]
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "request_id", "correlation_id", "status", "server_time"],
      "properties": {
        "ok": { "type": "boolean" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "correlation_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["accepted", "ok", "rejected", "not_found"] },
        "server_time": { "$ref": "#/$defs/dateTime" },
        "execution_id": { "$ref": "#/$defs/id" },
        "execution_status": { "$ref": "#/$defs/executionStatus" },
        "event_seq": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "events": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/event" } },
        "error": { "$ref": "#/$defs/error" }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": false } } },
          "then": { "required": ["error"], "properties": { "status": { "enum": ["rejected", "not_found"] } } }
        },
        {
          "if": { "properties": { "ok": { "const": true } } },
          "then": { "properties": { "status": { "enum": ["accepted", "ok"] } } }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_seq", "occurred_at", "event_type", "execution_id", "status"],
      "properties": {
        "event_id": { "$ref": "#/$defs/requestId" },
        "event_seq": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "occurred_at": { "$ref": "#/$defs/dateTime" },
        "event_type": { "enum": ["execution_accepted", "page_started", "page_completed", "page_failed", "pause_pending", "paused", "execution_completed", "execution_failed", "execution_cancelled", "host_blocked"] },
        "execution_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/executionStatus" },
        "page_id": { "$ref": "#/$defs/id" },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_seq", "occurred_at", "event_type", "execution_id", "status"],
      "properties": {
        "event_id": { "$ref": "#/$defs/requestId" },
        "event_seq": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "occurred_at": { "$ref": "#/$defs/dateTime" },
        "event_type": { "enum": ["execution_accepted", "page_started", "page_completed", "page_failed", "pause_pending", "paused", "execution_completed", "execution_failed", "execution_cancelled", "host_blocked"] },
        "execution_id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/executionStatus" },
        "page_id": { "$ref": "#/$defs/id" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
