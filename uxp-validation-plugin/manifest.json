{
  "manifestVersion": 5,
  "id": "local.ecommerce.uxp-validation",
  "name": "UXP Validation Probe",
  "version": "0.4.7",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.3.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "validation-panel",
      "label": {
        "default": "UXP Validation"
      },
      "minimumSize": {
        "width": 320,
        "height": 420
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 620
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    }
  }
}
