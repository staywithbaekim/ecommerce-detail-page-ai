<UserControl x:Class="Desktop.App.BatchPageSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid>
        <Grid Grid.Row="0"
              Panel.ZIndex="30"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsBatchPageSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="BatchPageSelectionDialog"
              AutomationProperties.Name="选择本批次页面"
              AutomationProperties.LiveSetting="Assertive">
            <Border Width="560"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="选择本批次页面" />
                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               Style="{StaticResource SmallBodyTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="取消页面只影响当前批次，不会修改模板组。" />
                    <CheckBox Grid.Row="2"
                              Margin="0,18,0,8"
                              IsThreeState="True"
                              IsChecked="{Binding AreAllBatchPagesSelected, Mode=TwoWay}"
                              Content="全选本批次页面"
                              AutomationProperties.AutomationId="SelectAllBatchPagesCheckBox" />
                    <ListBox Grid.Row="3"
                             MaxHeight="400"
                             ItemsSource="{Binding BatchPages}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.AutomationId="BatchPageSelectionList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SurfaceListItemStyle}">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="12,8"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding BatchPageSelectionSummary}" />
                        <Button Grid.Column="1"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelBatchPageSelectionCommand}"
                                Content="取消"
                                AutomationProperties.AutomationId="CancelBatchPageSelectionButton" />
                        <Button Grid.Column="3"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplyBatchPageSelectionCommand}"
                                Content="应用页面选择"
                                AutomationProperties.AutomationId="ApplyBatchPageSelectionButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
