                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowCalibrationPagesCommand}"
                                        Content="页面"
                                        AutomationProperties.AutomationId="ShowCalibrationPagesButton" />
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowCalibrationCanvasCommand}"
                                        Content="画布"
                                        AutomationProperties.AutomationId="ShowCalibrationCanvasButton" />
                                <Button Width="140"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowCalibrationInspectorCommand}"
                                        Content="素材与规则"
                                        AutomationProperties.AutomationId="ShowCalibrationInspectorButton" />
                            </StackPanel>
                             <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CalibrationPageColumnWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationPanelGapWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationCanvasColumnWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationPanelGapWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationInspectorColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Style="{StaticResource SectionCardStyle}"
                                        Padding="0"
                                        Visibility="{Binding IsCalibrationPagePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                     <Grid ClipToBounds="True">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="60" />
                                             <RowDefinition Height="220" />
                                             <RowDefinition Height="44" />
                                             <RowDefinition Height="*" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>
                                         <Border Grid.Row="0"
                                                 Padding="12,10"
                                                 Background="{StaticResource SurfaceSubtleBrush}">
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="Auto" />
                                                 </Grid.ColumnDefinitions>
                                                 <TextBlock VerticalAlignment="Center"
                                                            FontSize="14"
                                                            FontWeight="Medium"
                                                            Text="待校准页面" />
                                                 <Button Grid.Column="1"
                                                         Style="{StaticResource CompactButtonStyle}"
                                                         Command="{Binding RemoveTemplatePageCommand}"
                                                         CommandParameter="{Binding SelectedTemplatePage}"
                                                         IsEnabled="{Binding SelectedTemplatePage.CanRemove}"
                                                         Content="移除"
                                                         AutomationProperties.AutomationId="RemoveCalibrationPageButton" />
                                             </Grid>
                                         </Border>
                                        <ListBox Grid.Row="1"
                                                 Padding="7,7,7,0"
                                                 MaxHeight="220"
                                                 ItemsSource="{Binding TemplatePages}"
                                                 SelectedItem="{Binding SelectedTemplatePage, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.AutomationId="CalibrationPageList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="58"
                                                            Margin="0,3"
                                                            Padding="12,7"
                                                            CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                 Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Top"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding DisplayOrder}" />
                                                            <StackPanel Grid.Column="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="Medium"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Margin="8,0,0,0"
                                                                               FontSize="11"
                                                                               Foreground="#237A45"
                                                                               Text="{Binding Status}" />
                                                                </Grid>
                                                                <TextBlock Margin="0,3,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="{Binding RuleSummary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="2"
                                                Padding="12,0"
                                                Background="{StaticResource SurfaceSubtleBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,1">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Text="图片框" />
                                        </Border>
                                         <ListBox Grid.Row="3"
                                                  Padding="7,7,7,0"
                                                  ItemsSource="{Binding CalibrationDraft.Frames}"
                                                  SelectedValuePath="FrameId"
                                                  SelectedValue="{Binding CalibrationFrameIdInput, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  PreviewKeyDown="CalibrationFrameList_PreviewKeyDown"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="CalibrationFrameList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                         <Border MinHeight="52"
                                                                 Margin="0,3"
                                                                 Padding="12,7"
                                                                 CornerRadius="8"
                                                                 BorderThickness="1"
                                                                 PreviewMouseLeftButtonDown="CalibrationFrame_MouseLeftButtonDown">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="Transparent" />
                                                                     <Setter Property="BorderBrush" Value="Transparent" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                      Value="True">
                                                                             <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                                             <Setter Property="BorderBrush" Value="#D2D2D6" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <StackPanel>
                                                                 <TextBlock FontWeight="Medium"
                                                                            Text="{Binding LayerName}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                 <TextBlock Margin="0,3,0,0"
                                                                            FontSize="11"
                                                                            Foreground="{StaticResource TextMutedBrush}"
                                                                            Text="{Binding RegistrationLabel}" />
                                                             </StackPanel>
                                                         </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="4"
                                                Padding="12,10"
                                                Background="{StaticResource SurfaceSubtleBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding CalibrationDraft.StatusMessage}"
                                                           TextWrapping="Wrap" />
                                                 <TextBlock Margin="0,6,0,0"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="{Binding TemplateStatusMessage}"
                                                            TextWrapping="Wrap"
                                                            AutomationProperties.AutomationId="CalibrationOperationStatus" />
                                             </StackPanel>
                                         </Border>
                                     </Grid>
                                 </Border>
                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        AllowDrop="True"
                                        Focusable="True"
                                        IsEnabled="{Binding CanEditCalibration}"
                                        ClipToBounds="True"
                                        DragOver="CalibrationCanvas_DragOver"
                                        Drop="CalibrationCanvas_Drop"
                                        PreviewMouseLeftButtonDown="CalibrationCanvas_MouseLeftButtonDown"
                                        PreviewMouseMove="CalibrationCanvas_MouseMove"
                                        PreviewMouseLeftButtonUp="CalibrationCanvas_MouseLeftButtonUp"
                                        PreviewMouseWheel="CalibrationCanvas_MouseWheel"
                                        KeyDown="CalibrationCanvas_KeyDown"
                                        Visibility="{Binding IsCalibrationCanvasPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="CalibrationCanvas">
                                    <Grid>
                                        <Border Margin="16"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{StaticResource CanvasStageBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding CalibrationViewportZoom}"
                                                                ScaleY="{Binding CalibrationViewportZoom}" />
                                            </Border.RenderTransform>
                                            <Viewbox x:Name="CalibrationPreviewViewbox" Stretch="Uniform">
                                                <Grid Width="{Binding CalibrationCanvasWidth}"
                                                      Height="{Binding CalibrationCanvasHeight}"
                                                      Background="#FFFFFF">
                                                    <Image Source="{Binding CalibrationTemplatePreviewImagePath}"
                                                           Stretch="Fill"
                                                           AutomationProperties.AutomationId="CalibrationTemplatePreviewImage" />
                                                     <Canvas>
                                                         <ItemsControl ItemsSource="{Binding CalibrationDraft.Frames}"
                                                                       Panel.ZIndex="1">
                                                             <ItemsControl.ItemsPanel>
                                                                 <ItemsPanelTemplate>
                                                                     <Canvas />
                                                                 </ItemsPanelTemplate>
                                                             </ItemsControl.ItemsPanel>
                                                             <ItemsControl.ItemContainerStyle>
                                                                 <Style TargetType="ContentPresenter">
                                                                     <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                     <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                 </Style>
                                                             </ItemsControl.ItemContainerStyle>
                                                             <ItemsControl.ItemTemplate>
                                                                 <DataTemplate>
                                                                     <Border Width="{Binding Width}"
                                                                             Height="{Binding Height}"
                                                                             BorderThickness="1"
                                                                             Background="#0AFFFFFF"
                                                                             PreviewMouseLeftButtonDown="CalibrationFrame_MouseLeftButtonDown">
                                                                         <Border.Style>
                                                                             <Style TargetType="Border">
                                                                                 <Setter Property="BorderBrush" Value="#A0A1A7" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                         <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                                                                         <Setter Property="BorderThickness" Value="2" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </Border.Style>
                                                                     </Border>
                                                                 </DataTemplate>
                                                             </ItemsControl.ItemTemplate>
                                                         </ItemsControl>
                                                     <Border Canvas.Left="{Binding CalibrationFrameLeft}"
                                                             Canvas.Top="{Binding CalibrationFrameTop}"
                                                             Width="{Binding CalibrationFrameWidth}"
                                                             Height="{Binding CalibrationFrameHeight}"
                                                             BorderBrush="{StaticResource TextBrush}"
                                                             BorderThickness="0"
                                                             Panel.ZIndex="2"
                                                             ClipToBounds="True">
                                                         <Grid>
                                                             <Image Source="{Binding CalibrationPreviewImagePath}"
                                                                    Stretch="UniformToFill"
                                                                    RenderTransformOrigin="0.5,0.5"
                                                                    AutomationProperties.AutomationId="CalibrationPreviewImage">
                                                                 <Image.RenderTransform>
                                                                     <TransformGroup>
                                                                         <ScaleTransform ScaleX="{Binding CalibrationScaleInput}"
                                                                                         ScaleY="{Binding CalibrationScaleInput}" />
                                                                         <TranslateTransform X="{Binding CalibrationOffsetXInput}"
                                                                                             Y="{Binding CalibrationOffsetYInput}" />
                                                                     </TransformGroup>
                                                                 </Image.RenderTransform>
                                                             </Image>
                                                             <Border BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="2"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Top"
                                                                     Margin="-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,-4,-4,0"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="-4,0,0,-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="0,0,-4,-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                         </Grid>
                                                     </Border>
                                                    </Canvas>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               IsHitTestVisible="False"
                                                               Text="拖入代表款素材，或在右侧选择文件"
                                                               AutomationProperties.AutomationId="CalibrationCanvasLabel">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CalibrationPreviewImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="4"
                                        Style="{StaticResource SectionCardStyle}"
                                        Padding="0"
                                        ClipToBounds="True"
                                        Visibility="{Binding IsCalibrationInspectorPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0"
                                                    Margin="12,8"
                                                    Orientation="Horizontal">
                                            <Border Width="72"
                                                    Height="32"
                                                    Background="{StaticResource SurfaceStrongBrush}"
                                                    CornerRadius="8">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Medium"
                                                           Text="素材" />
                                            </Border>
                                            <Border Width="72" Height="32" Margin="8,0,0,0">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontWeight="Medium"
                                                           Text="规则" />
                                            </Border>
                                        </StackPanel>
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="16,12,16,16">
                                         <StackPanel Margin="0,0,0,16">
                                             <TextBlock FontSize="12"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="当前图片框" />
                                             <TextBlock Margin="0,4,0,0"
                                                        FontSize="13"
                                                        FontWeight="Medium"
                                                        Text="{Binding CalibrationFrameDisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                         </StackPanel>
                                         <TextBlock Margin="0,0,0,7"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    Text="代表款素材（源文件只读）" />
                                         <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                             <Button Margin="0,0,8,0"
                                                     Style="{StaticResource SecondaryButtonStyle}"
                                                     Click="ChooseCalibrationAsset_Click"
                                                     IsEnabled="{Binding CanEditCalibration}"
                                                     Content="{Binding CalibrationAssetActionText}"
                                                     AutomationProperties.AutomationId="BindCalibrationAssetButton" />
                                             <Button Style="{StaticResource SecondaryButtonStyle}"
                                                     Command="{Binding ClearCalibrationAssetCommand}"
                                                     IsEnabled="{Binding CanClearCalibrationAsset}"
                                                     Content="移除素材"
                                                     ToolTip="从当前图片框移除素材；不会删除电脑中的源文件"
                                                     AutomationProperties.AutomationId="ClearCalibrationAssetButton" />
                                         </StackPanel>
                                         <Expander Margin="0,20,0,0"
                                                   IsExpanded="False"
                                                   IsEnabled="{Binding CanEditCalibration}"
                                                   Header="高级调整（可选）"
                                                   AutomationProperties.AutomationId="AdvancedCalibrationExpander">
                                             <StackPanel Margin="0,10,0,0">
                                                 <TextBlock Margin="0,0,0,7"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="主流程只需确认素材；缩放和偏移用于需要时的细调。" />
                                                 <UniformGrid Columns="3">
                                                     <TextBox Margin="0,0,6,0"
                                                              Style="{StaticResource FieldTextBoxStyle}"
                                                              ToolTip="缩放比例，例如 1.08"
                                                              Text="{Binding CalibrationScaleInput, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.AutomationId="CalibrationScaleInput" />
                                                     <TextBox Margin="0,0,6,0"
                                                              Style="{StaticResource FieldTextBoxStyle}"
                                                              ToolTip="水平偏移"
                                                              Text="{Binding CalibrationOffsetXInput, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.AutomationId="CalibrationOffsetXInput" />
                                                     <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                              ToolTip="垂直偏移"
                                                              Text="{Binding CalibrationOffsetYInput, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.AutomationId="CalibrationOffsetYInput" />
                                                 </UniformGrid>
                                             </StackPanel>
                                         </Expander>
                                         <TextBlock Margin="0,16,0,7"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Text="规则 · 选图要求" />
                                         <TextBox MinHeight="58"
                                                  IsEnabled="{Binding CanEditCalibration}"
                                                  Style="{StaticResource FieldTextBoxStyle}"
                                                  ToolTip="用中文描述当前框需要的素材，例如：正面全身图，商品主体完整"
                                                  Text="{Binding CalibrationRequirementInput, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 InputMethod.IsInputMethodEnabled="True"
                                                 AutomationProperties.AutomationId="CalibrationRequirementInput" />
                                        <Button Margin="0,10,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ApplyCalibrationGeometryCommand}"
                                                IsEnabled="{Binding CanEditCalibration}"
                                                Content="应用布局与规则"
                                                AutomationProperties.AutomationId="ApplyCalibrationGeometryButton" />
                                        <TextBlock Margin="0,22,0,7"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Text="已登记素材" />
                                        <ListBox MaxHeight="150"
                                                 ItemsSource="{Binding CalibrationDraft.Assets}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 PreviewMouseLeftButtonDown="CalibrationAssetList_MouseLeftButtonDown"
                                                 PreviewMouseMove="CalibrationAssetList_MouseMove"
                                                 AutomationProperties.AutomationId="CalibrationAssetList">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                     </StackPanel>
                                     </ScrollViewer>
                                     </Grid>
                                 </Border>
                             </Grid>
                             <Border Grid.Row="5"
                                     Margin="0,12,0,0"
                                     Padding="12,9"
                                     Background="{StaticResource SurfaceSubtleBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     AutomationProperties.AutomationId="CalibrationStatusBar">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding CalibrationDraft.StatusMessage}"
                                                TextTrimming="CharacterEllipsis" />
                                     <TextBlock Grid.Column="1"
                                                Margin="16,0,0,0"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding CalibrationZoomText}"
                                                TextTrimming="CharacterEllipsis" />
                                 </Grid>
                             </Border>
                         </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="{Binding PageTitle}"
                                               AutomationProperties.AutomationId="PlaceholderPageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding PageSubtitle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding PrimaryActionText}"
                                        Visibility="{Binding HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                Padding="24"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding EmptyTitle}" />
                                <ItemsControl Margin="0,18,0,0"
                                              ItemsSource="{Binding PageRows}"
                                              AutomationProperties.AutomationId="SettingsSectionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="48"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="30"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsBatchPageSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="BatchPageSelectionDialog"
              AutomationProperties.Name="选择本批次页面"
              AutomationProperties.LiveSetting="Assertive">
            <Border Width="560"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="选择本批次页面" />
                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               Style="{StaticResource SmallBodyTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="取消页面只影响当前批次，不会修改模板组。" />
                    <CheckBox Grid.Row="2"
                              Margin="0,18,0,8"
                              IsThreeState="True"
                              IsChecked="{Binding AreAllBatchPagesSelected, Mode=TwoWay}"
                              Content="全选本批次页面"
                              AutomationProperties.AutomationId="SelectAllBatchPagesCheckBox" />
                    <ListBox Grid.Row="3"
                             MaxHeight="400"
                             ItemsSource="{Binding BatchPages}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.AutomationId="BatchPageSelectionList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SurfaceListItemStyle}">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="12,8"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding BatchPageSelectionSummary}" />
                        <Button Grid.Column="1"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelBatchPageSelectionCommand}"
                                Content="取消"
                                AutomationProperties.AutomationId="CancelBatchPageSelectionButton" />
                        <Button Grid.Column="3"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplyBatchPageSelectionCommand}"
                                Content="应用页面选择"
                                AutomationProperties.AutomationId="ApplyBatchPageSelectionButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="30"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsTemplateDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="TemplateDialog_PreviewKeyDown"
              AutomationProperties.AutomationId="TemplateConfirmationDialog"
              AutomationProperties.Name="{Binding TemplateDialogTitle}"
              AutomationProperties.LiveSetting="Assertive">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               LineHeight="24"
                               Text="{Binding TemplateDialogTitle}" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding TemplateDialogBody}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14,12"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Top"
                                     Margin="0,6,0,0"
                                     Fill="{StaticResource StatusAnalyzingBrush}" />
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource SmallBodyTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding TemplateDialogSafetyNote}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding TertiaryTemplateDialogCommand}"
                                Content="{Binding TemplateDialogTertiaryText}"
                                Visibility="{Binding TemplateDialogHasTertiaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="TemplateDialogTertiaryButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SecondaryTemplateDialogCommand}"
                                Content="{Binding TemplateDialogSecondaryText}"
                                Visibility="{Binding TemplateDialogHasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="TemplateDialogSecondaryButton" />
                        <Button IsDefault="True"
                                Command="{Binding ConfirmTemplateDialogCommand}"
                                Content="{Binding TemplateDialogPrimaryText}"
                                AutomationProperties.AutomationId="TemplateDialogPrimaryButton">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemplateDialogIsDestructive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="20"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsDuplicateReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="DuplicatePsdReviewDialog"
              AutomationProperties.Name="重复 PSD 确认"
              AutomationProperties.LiveSetting="Assertive">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="检测到内容相同的 PSD" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="系统不会自动删除任何源文件。请选择这次导入应如何处理："
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="{Binding DuplicateExistingLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="复用模板库中已经验证的应用内部副本。" />
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="Medium"
                                       Text="{Binding DuplicateImportedLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="保留本次复制，作为独立页面继续检查。" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDuplicateCommand}"
                                Content="取消本次导入"
                                AutomationProperties.AutomationId="CancelDuplicateButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding KeepImportedDuplicateCommand}"
                                Content="保留本次导入"
                                AutomationProperties.AutomationId="KeepImportedDuplicateButton" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding KeepExistingDuplicateCommand}"
                                Content="复用已有副本"
                                AutomationProperties.AutomationId="ReuseExistingDuplicateButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Height="64"
                Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="ActiveTaskBar">
            <Grid Margin="24,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="恢复验证任务" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="需要恢复 · 上次安全检查点" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="只读投影" />
            </Grid>
        </Border>
    </Grid>
</Window>
