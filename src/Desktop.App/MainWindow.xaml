                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="{Binding TemplatePageSettingsInspectorColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Padding="0"
                                        Style="{StaticResource SectionCardStyle}">
