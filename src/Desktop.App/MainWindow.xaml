<Window x:Class="Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="电商详情页智能生产系统"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DesktopMainWindow">
    <Window.Resources>
        <DataTemplate x:Key="TaskRowTemplate">
            <Border Height="68"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   LineHeight="18"
                                   Text="{Binding TaskName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding TemplateName}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusLight"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource StatusAnalyzingBrush}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="6"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding UpdatedText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{Binding ActionText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Completed">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Paused">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusPausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Recoverable">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TemplateLibraryCardTemplate">
            <Button Margin="0,0,0,12"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    FocusVisualStyle="{StaticResource VisibleFocusStyle}"
                    AutomationProperties.Name="{Binding Name}">
                <Border Height="82"
                        Padding="18,14"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding Meta}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding UpdatedText}" />
                        <StackPanel Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource StatusDraftBrush}" />
                            <TextBlock Text="{Binding Status}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="14"
                                   Text="&#xE76C;" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ImportedPsdTemplate">
            <Border Height="58"
                    Padding="14,8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="16"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="&#xE7C3;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium"
                                   Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding InspectionSummary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#237A45"
                               Text="{Binding Status}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TemplateDetailPageTemplate">
            <Border Height="64"
                    Padding="14,8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding OrderText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#237A45"
                               Text="{Binding Status}" />
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Text="{Binding Action}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TemplatePageListItemTemplate">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="34" />
                     <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="&#xE700;" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding DisplayOrder}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding Status}" />
                </StackPanel>
                 <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Width="26"
                            Height="22"
                            MinWidth="26"
                            Margin="0,0,0,2"
                            Padding="0"
                            Style="{StaticResource CompactButtonStyle}"
                            Tag="{Binding}"
                            Click="MoveTemplatePageUp_Click"
                            AutomationProperties.Name="上移页面">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70E;" />
                    </Button>
                    <Button Width="26"
                            Height="22"
                            MinWidth="26"
                            Padding="0"
                            Style="{StaticResource CompactButtonStyle}"
                            Tag="{Binding}"
                            Click="MoveTemplatePageDown_Click"
                            AutomationProperties.Name="下移页面">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" />
                     </Button>
                 </StackPanel>
                 <Button Grid.Column="4"
                         Width="44"
                         Height="26"
                         Margin="8,0,0,0"
                         Padding="0"
                         VerticalAlignment="Center"
                         Style="{StaticResource CompactButtonStyle}"
                         Command="{Binding DataContext.RemoveTemplatePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         IsEnabled="{Binding CanRemove}"
                         Content="移除"
                         AutomationProperties.Name="移除模板页面" />
             </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}"
          AutomationProperties.AutomationId="DesktopShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="16,20,16,16"
                                AutomationProperties.AutomationId="ApplicationBrand">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   Text="电商详情页" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="智能生产系统" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                    <Border Grid.Row="2" Margin="8,16,8,16">
                        <ListBox x:Name="PrimaryNavigationList"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.AutomationId="PrimaryNavigation">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <DockPanel LastChildFill="False" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemChrome"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F1F1F2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFooterNavigation}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Glyph}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="PageScrollViewer">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTemplateCalibrationVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid Margin="32"
                      AutomationProperties.AutomationId="PageContent">
                    <Grid Visibility="{Binding IsWorkbenchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="264" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="工作台"
                                               AutomationProperties.AutomationId="PageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               LineHeight="22"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="继续活动任务或开始新的批量生产" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,11,0,11"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="PrimaryPageAction"
                                        AutomationProperties.HelpText="阶段 0 只读投影，业务命令尚未接入">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Text="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="新建批次" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="进行中" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding ActiveTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AutomationProperties.AutomationId="ActiveTaskList" />
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="最近任务" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding RecentTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AlternationCount="3"
                                          AutomationProperties.AutomationId="RecentTaskList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,12" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                <Setter Property="FrameworkElement.Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="RecoveryFixturePanel">
                            <TextBlock Margin="0,0,0,8" Text="任务名称" />
                            <TextBox Width="360"
                                     Height="40"
                                     HorizontalAlignment="Left"
                                     Padding="10,7"
                                     InputMethod.IsInputMethodEnabled="True"
                                     AutomationProperties.AutomationId="ChineseImeFixtureInput" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsTemplateSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="TemplateWorkspace">
                        <!-- T-01: template library and detail use real application projections. -->
                        <Grid Visibility="{Binding IsTemplateLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateLibraryPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="模板"
                                               AutomationProperties.AutomationId="TemplateLibraryTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="管理模板组、页面和校准状态" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,11,8,11"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ImportTemplatePackageCommand}"
                                            Content="导入模板包"
                                            AutomationProperties.AutomationId="ImportTemplatePackageButton" />
                                    <Button Margin="0,11,0,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding NewTemplateCommand}"
                                            AutomationProperties.AutomationId="NewTemplateGroupButton"
                                            AutomationProperties.Name="新建模板组">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Text="&#xE710;" />
                                            <TextBlock Text="新建模板组" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <StackPanel Visibility="{Binding HasTemplateGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="18,0,18,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="模板组" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="最近更新" />
                                        <TextBlock Grid.Column="2"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="状态" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TemplateGroups}"
                                                  ItemTemplate="{StaticResource TemplateLibraryCardTemplate}"
                                                  AutomationProperties.AutomationId="TemplateGroupList" />
                                </StackPanel>

                                <Border Padding="48,64"
                                        Style="{StaticResource SectionCardStyle}"
                                        Visibility="{Binding IsTemplateLibraryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="TemplateLibraryEmptyState">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource SurfaceStrongBrush}"
                                                CornerRadius="24">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="22"
                                                       Text="&#xE8A5;" />
                                        </Border>
                                        <TextBlock Margin="0,18,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="尚无模板组" />
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="从一个或多个 PSD 开始建立可重复使用的模板页面。" />
                                        <Button Margin="0,22,0,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding NewTemplateCommand}"
                                                Content="新建模板组"
                                                AutomationProperties.AutomationId="EmptyNewTemplateGroupButton" />
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateDetailsPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                             <Grid>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Width="84"
                                            Height="28"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Command="{Binding BackToTemplateLibraryCommand}"
                                            Content="← 返回"
                                            AutomationProperties.AutomationId="BackToTemplateLibraryButton" />
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               Text="{Binding TemplateDetailsTitle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateDetailsMeta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="删除"
                                            Command="{Binding DeleteTemplateCommand}"
                                            AutomationProperties.AutomationId="DeleteTemplateGroupButton" />
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="另存为"
                                            Command="{Binding SaveTemplateAsCommand}"
                                            AutomationProperties.AutomationId="SaveTemplateAsButton" />
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="导出"
                                            Command="{Binding ExportTemplateCommand}"
                                            AutomationProperties.AutomationId="ExportTemplatePackageButton" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddTemplatePagesCommand}"
                                            IsEnabled="{Binding CanIncrementTemplate}"
                                            Content="添加模板页面"
                                            AutomationProperties.AutomationId="AddTemplatePagesButton" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="模板页面" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="页面顺序决定详情页输出顺序" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TemplateDetailPages}"
                                                  ItemTemplate="{StaticResource TemplateDetailPageTemplate}"
                                                  AutomationProperties.AutomationId="TemplateDetailPageList" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- T-02: source selection stays read-only; only application-owned copies are passed to the workspace service. -->
                        <Grid Visibility="{Binding IsTemplateImportVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplatePsdImportPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Width="84"
                                            Height="28"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource CompactButtonStyle}"
                                            Command="{Binding BackToTemplateLibraryCommand}"
                                            Content="← 返回"
                                            AutomationProperties.AutomationId="CancelTemplateImportButton" />
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               Text="{Binding TemplateFlowTitle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateFlowSubtitle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Bottom"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="步骤 1 / 3 · 选择 PSD" />
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,7"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Text="模板组名称" />
                                    <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding TemplateGroupName, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsIncrementalTemplateDraft}"
                                             InputMethod.IsInputMethodEnabled="True"
                                             AutomationProperties.AutomationId="TemplateGroupNameInput"
                                             AutomationProperties.Name="模板组名称" />

                                    <Border Margin="0,18,0,0"
                                            MinHeight="150"
                                            Padding="24"
                                            Background="{StaticResource SurfaceSubtleBrush}"
                                            BorderBrush="#A8A8AD"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            AllowDrop="True"
                                            DragOver="PsdDropZone_DragOver"
                                            Drop="PsdDropZone_Drop"
                                            AutomationProperties.AutomationId="TemplatePsdDropZone"
                                            AutomationProperties.Name="PSD 文件拖放区域">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="24"
                                                       Text="&#xE8B7;" />
                                            <TextBlock Margin="0,10,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Text="将 PSD 拖到这里" />
                                            <TextBlock Margin="0,4,0,12"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="或通过按钮选择一个或多个文件；源文件始终只读" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ChoosePsdFiles_Click"
                                                    Content="选择 PSD 文件"
                                                    AutomationProperties.AutomationId="ChoosePsdFilesButton" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4"
                                    Padding="0"
                                    Style="{StaticResource SectionCardStyle}"
                                    Visibility="{Binding HasImportedTemplateFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="18,14,18,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="已检查的 PSD" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding ImportedTemplateFiles.Count, StringFormat={}{0} 个页面}" />
                                    </Grid>
                                    <ItemsControl Grid.Row="1"
                                                  ItemsSource="{Binding ImportedTemplateFiles}"
                                                  ItemTemplate="{StaticResource ImportedPsdTemplate}"
                                                  AutomationProperties.AutomationId="ImportedPsdList" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="5"
                                        Margin="0,20,0,0"
                                        Orientation="Horizontal">
                                <TextBlock Width="520"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding TemplateStatusMessage}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding BackToTemplateLibraryCommand}"
                                        Content="取消" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ContinuePageSettingsCommand}"
                                        IsEnabled="{Binding CanContinuePageSettings}"
                                        Content="继续设置页面"
                                        AutomationProperties.AutomationId="ContinuePageSettingsButton" />
                            </StackPanel>
                        </Grid>

                        <!-- T-03: page settings, order and incremental read-only scope. -->
                        <Grid Visibility="{Binding IsTemplatePageSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplatePageSettingsPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               Text="页面设置" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateSettingsSubtitle}" />
                                </StackPanel>
                                 <StackPanel Grid.Column="1" Orientation="Horizontal">
                                     <Button Margin="0,0,12,0"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                             Command="{Binding AbandonTemplateDraftCommand}"
                                             Content="放弃当前模板组"
                                             AutomationProperties.AutomationId="AbandonTemplateDraftButton" />
                                     <TextBlock VerticalAlignment="Center"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="步骤 2 / 3 · 页面规则" />
                                 </StackPanel>
                             </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Padding="0"
                                        Style="{StaticResource SectionCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="54" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="16,12,16,8">
                                            <TextBlock FontWeight="SemiBold" Text="模板页面" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="拖放或按钮调整输出顺序" />
                                        </StackPanel>
                                         <ListBox Grid.Row="1"
                                                  ItemsSource="{Binding TemplatePages}"
                                                  SelectedItem="{Binding SelectedTemplatePage, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource TemplatePageListItemTemplate}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  AllowDrop="True"
                                                 PreviewMouseLeftButtonDown="TemplatePageList_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="TemplatePageList_PreviewMouseMove"
                                                 DragOver="TemplatePageList_DragOver"
                                                 Drop="TemplatePageList_Drop"
                                                 KeyDown="TemplatePageList_KeyDown"
                                                 AutomationProperties.AutomationId="TemplatePageOrderList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="MinHeight" Value="62" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Button Grid.Row="2"
                                                Margin="12"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ReturnToTemplateImportCommand}"
                                                Content="继续添加 PSD"
                                                AutomationProperties.AutomationId="ReturnToPsdImportButton" />
                                    </Grid>
                                 </Border>

                                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="页面预览" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding SelectedTemplatePage.Name}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding SelectedTemplatePage.CanvasSummary}" />
                                        </Grid>
                                        <Border Height="420"
                                                Background="#F4F4F5"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding SelectedTemplatePage.PreviewSourceReference}"
                                                       Stretch="Uniform"
                                                       AutomationProperties.AutomationId="TemplatePageSettingsPreviewImage" />
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTemplatePage.PreviewSourceReference}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="24"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="&#xE8B7;" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="暂无预览" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="0,12,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="预览来自应用副本；源 PSD 保持只读。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}">
                                    <ContentControl Content="{Binding SelectedTemplatePage}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate DataType="{x:Type local:TemplatePageRowViewModel}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,18">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Text="页面属性" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding CanvasSummary}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Padding="9,4"
                                                                Background="{StaticResource SurfaceStrongBrush}"
                                                                CornerRadius="12">
                                                            <TextBlock FontSize="12" Text="{Binding Status}" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Margin="0,0,0,7"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="页面名称" />
                                                    <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsReadOnly}"
                                                             InputMethod.IsInputMethodEnabled="True"
                                                             AutomationProperties.AutomationId="TemplatePageNameInput"
                                                             AutomationProperties.Name="页面名称" />

                                                    <TextBlock Margin="0,18,0,7"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="内容类型" />
                                                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                                              ItemsSource="{x:Static local:TemplatePageRowViewModel.ContentTypeOptions}"
                                                              SelectedItem="{Binding ContentTypeText, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsAffected}"
                                                              AutomationProperties.AutomationId="TemplatePageContentTypeSelect" />

                                                    <TextBlock Margin="0,18,0,7"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Text="生成方式" />
                                                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                                              ItemsSource="{x:Static local:TemplatePageRowViewModel.GenerationModeOptions}"
                                                              SelectedItem="{Binding GenerationModeText, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsAffected}"
                                                              AutomationProperties.AutomationId="TemplatePageGenerationModeSelect" />

                                                    <StackPanel Margin="0,18,0,0"
                                                                Visibility="{Binding IsVariantCapacityVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Margin="0,0,0,7"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Text="组合容量" />
                                                        <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                                 Text="{Binding VariantCapacity, UpdateSourceTrigger=LostFocus}"
                                                                 IsReadOnly="{Binding IsReadOnly}"
                                                                 AutomationProperties.AutomationId="TemplatePageVariantCapacityInput" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="必须填写大于 0 的数字" />
                                                    </StackPanel>

                                                    <CheckBox Margin="0,20,0,0"
                                                              Content="启用此页面"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsAffected}"
                                                              FocusVisualStyle="{StaticResource VisibleFocusStyle}"
                                                              AutomationProperties.AutomationId="TemplatePageEnabledCheckBox" />

                                                    <Border Margin="0,20,0,0"
                                                            Padding="12"
                                                            Background="{StaticResource InfoSurfaceBrush}"
                                                            CornerRadius="6">
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="{Binding RuleSummary}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding TemplateStatusMessage}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ReturnToTemplateImportCommand}"
                                            Content="上一步" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartCalibrationCommand}"
                                            Content="开始校准"
                                            AutomationProperties.AutomationId="StartCalibrationButton" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateCalibrationPendingVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateCalibrationPendingPage">
                            <Border Padding="48,64" Style="{StaticResource SectionCardStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="48"
                                            Height="48"
                                            Background="{StaticResource InfoSurfaceBrush}"
                                            CornerRadius="24">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="22"
                                                   Text="&#xE9D2;" />
                                    </Border>
                                    <TextBlock Margin="0,18,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="页面设置已保存" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateStatusMessage}"
                                               TextAlignment="Center" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="暂时无法打开校准编辑器；请返回页面设置，检查当前页结构或素材后重试。" />
                                    <Button Margin="0,22,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ReturnToPageSettingsCommand}"
                                            Content="返回页面设置" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateCalibrationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateCalibrationPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               Text="{Binding CalibrationHeaderTitle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="导入模板  /  页面设置  /  校准" />
                                 </StackPanel>
                                 <StackPanel Grid.Column="1" Orientation="Horizontal">
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                             Command="{Binding ExitCalibrationCommand}"
                                             Content="返回页面设置"
                                             AutomationProperties.AutomationId="ExitCalibrationButton" />
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                             Command="{Binding ReturnToTemplateImportCommand}"
                                             Content="继续添加 PSD"
                                             AutomationProperties.AutomationId="AddPsdFromCalibrationButton" />
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding UndoCalibrationCommand}"
                                            IsEnabled="{Binding CalibrationDraft.CanUndo}"
                                            Content="撤销"
                                            AutomationProperties.AutomationId="UndoCalibrationButton" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding RedoCalibrationCommand}"
                                            IsEnabled="{Binding CalibrationDraft.CanRedo}"
                                            Content="重做"
                                            AutomationProperties.AutomationId="RedoCalibrationButton" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveTemplateCommand}"
                                            Content="保存模板组"
                                            AutomationProperties.AutomationId="SaveTemplateGroupButton" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsCalibrationNarrowLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="CalibrationNarrowPanelSwitcher">
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowCalibrationPagesCommand}"
                                        Content="页面"
                                        AutomationProperties.AutomationId="ShowCalibrationPagesButton" />
                                <Button Width="120"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowCalibrationCanvasCommand}"
                                        Content="画布"
                                        AutomationProperties.AutomationId="ShowCalibrationCanvasButton" />
                                <Button Width="140"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ShowCalibrationInspectorCommand}"
                                        Content="素材与规则"
                                        AutomationProperties.AutomationId="ShowCalibrationInspectorButton" />
                            </StackPanel>
                             <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CalibrationPageColumnWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationPanelGapWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationCanvasColumnWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationPanelGapWidth}" />
                                    <ColumnDefinition Width="{Binding CalibrationInspectorColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Style="{StaticResource SectionCardStyle}"
                                        Padding="0"
                                        Visibility="{Binding IsCalibrationPagePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                     <Grid ClipToBounds="True">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="60" />
                                             <RowDefinition Height="220" />
                                             <RowDefinition Height="44" />
                                             <RowDefinition Height="*" />
                                             <RowDefinition Height="Auto" />
                                         </Grid.RowDefinitions>
                                         <Border Grid.Row="0"
                                                 Padding="12,10"
                                                 Background="{StaticResource SurfaceSubtleBrush}">
                                             <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="Auto" />
                                                 </Grid.ColumnDefinitions>
                                                 <TextBlock VerticalAlignment="Center"
                                                            FontSize="14"
                                                            FontWeight="Medium"
                                                            Text="待校准页面" />
                                                 <Button Grid.Column="1"
                                                         Style="{StaticResource CompactButtonStyle}"
                                                         Command="{Binding RemoveTemplatePageCommand}"
                                                         CommandParameter="{Binding SelectedTemplatePage}"
                                                         IsEnabled="{Binding SelectedTemplatePage.CanRemove}"
                                                         Content="移除"
                                                         AutomationProperties.AutomationId="RemoveCalibrationPageButton" />
                                             </Grid>
                                         </Border>
                                        <ListBox Grid.Row="1"
                                                 Padding="7,7,7,0"
                                                 MaxHeight="220"
                                                 ItemsSource="{Binding TemplatePages}"
                                                 SelectedItem="{Binding SelectedTemplatePage, Mode=TwoWay}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 AutomationProperties.AutomationId="CalibrationPageList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="58"
                                                            Margin="0,3"
                                                            Padding="12,7"
                                                            CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                 Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Top"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding DisplayOrder}" />
                                                            <StackPanel Grid.Column="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontWeight="Medium"
                                                                               Text="{Binding Name}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Margin="8,0,0,0"
                                                                               FontSize="11"
                                                                               Foreground="#237A45"
                                                                               Text="{Binding Status}" />
                                                                </Grid>
                                                                <TextBlock Margin="0,3,0,0"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Text="{Binding RuleSummary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="2"
                                                Padding="12,0"
                                                Background="{StaticResource SurfaceSubtleBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,1">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="Medium"
                                                       Text="图片框" />
                                        </Border>
                                         <ListBox Grid.Row="3"
                                                  Padding="7,7,7,0"
                                                  ItemsSource="{Binding CalibrationDraft.Frames}"
                                                  SelectedValuePath="FrameId"
                                                  SelectedValue="{Binding CalibrationFrameIdInput, Mode=TwoWay}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  PreviewKeyDown="CalibrationFrameList_PreviewKeyDown"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  AutomationProperties.AutomationId="CalibrationFrameList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                         <Border MinHeight="52"
                                                                 Margin="0,3"
                                                                 Padding="12,7"
                                                                 CornerRadius="8"
                                                                 BorderThickness="1"
                                                                 PreviewMouseLeftButtonDown="CalibrationFrame_MouseLeftButtonDown">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="Transparent" />
                                                                     <Setter Property="BorderBrush" Value="Transparent" />
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                                      Value="True">
                                                                             <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                                             <Setter Property="BorderBrush" Value="#D2D2D6" />
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <StackPanel>
                                                                 <TextBlock FontWeight="Medium"
                                                                            Text="{Binding LayerName}"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                 <TextBlock Margin="0,3,0,0"
                                                                            FontSize="11"
                                                                            Foreground="{StaticResource TextMutedBrush}"
                                                                            Text="{Binding RegistrationLabel}" />
                                                             </StackPanel>
                                                         </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="4"
                                                Padding="12,10"
                                                Background="{StaticResource SurfaceSubtleBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding CalibrationDraft.StatusMessage}"
                                                           TextWrapping="Wrap" />
                                                 <TextBlock Margin="0,6,0,0"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="{Binding TemplateStatusMessage}"
                                                            TextWrapping="Wrap"
                                                            AutomationProperties.AutomationId="CalibrationOperationStatus" />
                                             </StackPanel>
                                         </Border>
                                     </Grid>
                                 </Border>
                                <Border Grid.Column="2"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        AllowDrop="True"
                                        Focusable="True"
                                        IsEnabled="{Binding CanEditCalibration}"
                                        ClipToBounds="True"
                                        DragOver="CalibrationCanvas_DragOver"
                                        Drop="CalibrationCanvas_Drop"
                                        PreviewMouseLeftButtonDown="CalibrationCanvas_MouseLeftButtonDown"
                                        PreviewMouseMove="CalibrationCanvas_MouseMove"
                                        PreviewMouseLeftButtonUp="CalibrationCanvas_MouseLeftButtonUp"
                                        PreviewMouseWheel="CalibrationCanvas_MouseWheel"
                                        KeyDown="CalibrationCanvas_KeyDown"
                                        Visibility="{Binding IsCalibrationCanvasPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="CalibrationCanvas">
                                    <Grid>
                                        <Border Margin="16"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Background="{StaticResource CanvasBrush}"
                                                BorderBrush="#C8C8CC"
                                                BorderThickness="1"
                                                ClipToBounds="True"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding CalibrationViewportZoom}"
                                                                ScaleY="{Binding CalibrationViewportZoom}" />
                                            </Border.RenderTransform>
                                            <Viewbox x:Name="CalibrationPreviewViewbox" Stretch="Uniform">
                                                <Grid Width="{Binding CalibrationCanvasWidth}"
                                                      Height="{Binding CalibrationCanvasHeight}"
                                                      Background="#FFFFFF">
                                                    <Image Source="{Binding CalibrationTemplatePreviewImagePath}"
                                                           Stretch="Fill"
                                                           AutomationProperties.AutomationId="CalibrationTemplatePreviewImage" />
                                                     <Canvas>
                                                         <ItemsControl ItemsSource="{Binding CalibrationDraft.Frames}"
                                                                       Panel.ZIndex="1">
                                                             <ItemsControl.ItemsPanel>
                                                                 <ItemsPanelTemplate>
                                                                     <Canvas />
                                                                 </ItemsPanelTemplate>
                                                             </ItemsControl.ItemsPanel>
                                                             <ItemsControl.ItemContainerStyle>
                                                                 <Style TargetType="ContentPresenter">
                                                                     <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                     <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                                 </Style>
                                                             </ItemsControl.ItemContainerStyle>
                                                             <ItemsControl.ItemTemplate>
                                                                 <DataTemplate>
                                                                     <Border Width="{Binding Width}"
                                                                             Height="{Binding Height}"
                                                                             BorderThickness="1"
                                                                             Background="#0AFFFFFF"
                                                                             PreviewMouseLeftButtonDown="CalibrationFrame_MouseLeftButtonDown">
                                                                         <Border.Style>
                                                                             <Style TargetType="Border">
                                                                                 <Setter Property="BorderBrush" Value="#A0A1A7" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                         <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                                                                         <Setter Property="BorderThickness" Value="2" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </Border.Style>
                                                                     </Border>
                                                                 </DataTemplate>
                                                             </ItemsControl.ItemTemplate>
                                                         </ItemsControl>
                                                     <Border Canvas.Left="{Binding CalibrationFrameLeft}"
                                                             Canvas.Top="{Binding CalibrationFrameTop}"
                                                             Width="{Binding CalibrationFrameWidth}"
                                                             Height="{Binding CalibrationFrameHeight}"
                                                             BorderBrush="{StaticResource TextBrush}"
                                                             BorderThickness="0"
                                                             Panel.ZIndex="2"
                                                             ClipToBounds="True">
                                                         <Grid>
                                                             <Image Source="{Binding CalibrationPreviewImagePath}"
                                                                    Stretch="UniformToFill"
                                                                    RenderTransformOrigin="0.5,0.5"
                                                                    AutomationProperties.AutomationId="CalibrationPreviewImage">
                                                                 <Image.RenderTransform>
                                                                     <TransformGroup>
                                                                         <ScaleTransform ScaleX="{Binding CalibrationScaleInput}"
                                                                                         ScaleY="{Binding CalibrationScaleInput}" />
                                                                         <TranslateTransform X="{Binding CalibrationOffsetXInput}"
                                                                                             Y="{Binding CalibrationOffsetYInput}" />
                                                                     </TransformGroup>
                                                                 </Image.RenderTransform>
                                                             </Image>
                                                             <Border BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="2"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Top"
                                                                     Margin="-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,-4,-4,0"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="-4,0,0,-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="0,0,-4,-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                         </Grid>
                                                     </Border>
                                                    </Canvas>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               IsHitTestVisible="False"
                                                               Text="拖入代表款素材，或在右侧选择文件"
                                                               AutomationProperties.AutomationId="CalibrationCanvasLabel">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CalibrationPreviewImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="4"
                                        Style="{StaticResource SectionCardStyle}"
                                        Padding="0"
                                        ClipToBounds="True"
                                        Visibility="{Binding IsCalibrationInspectorPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="48" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0"
                                                    Margin="12,8"
                                                    Orientation="Horizontal">
                                            <Border Width="72"
                                                    Height="32"
                                                    Background="{StaticResource SurfaceStrongBrush}"
                                                    CornerRadius="8">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="Medium"
                                                           Text="素材" />
                                            </Border>
                                            <Border Width="72" Height="32" Margin="8,0,0,0">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontWeight="Medium"
                                                           Text="规则" />
                                            </Border>
                                        </StackPanel>
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="16,12,16,16">
                                         <StackPanel Margin="0,0,0,16">
                                             <TextBlock FontSize="12"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="当前图片框" />
                                             <TextBlock Margin="0,4,0,0"
                                                        FontSize="13"
                                                        FontWeight="Medium"
                                                        Text="{Binding CalibrationFrameDisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                         </StackPanel>
                                         <TextBlock Margin="0,0,0,7"
                                                    FontSize="14"
                                                    FontWeight="Medium"
                                                    Text="代表款素材（源文件只读）" />
                                         <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                             <Button Margin="0,0,8,0"
                                                     Style="{StaticResource SecondaryButtonStyle}"
                                                     Click="ChooseCalibrationAsset_Click"
                                                     IsEnabled="{Binding CanEditCalibration}"
                                                     Content="{Binding CalibrationAssetActionText}"
                                                     AutomationProperties.AutomationId="BindCalibrationAssetButton" />
                                             <Button Style="{StaticResource SecondaryButtonStyle}"
                                                     Command="{Binding ClearCalibrationAssetCommand}"
                                                     IsEnabled="{Binding CanClearCalibrationAsset}"
                                                     Content="移除素材"
                                                     ToolTip="从当前图片框移除素材；不会删除电脑中的源文件"
                                                     AutomationProperties.AutomationId="ClearCalibrationAssetButton" />
                                         </StackPanel>
                                         <Expander Margin="0,20,0,0"
                                                   IsExpanded="False"
                                                   IsEnabled="{Binding CanEditCalibration}"
                                                   Header="高级调整（可选）"
                                                   AutomationProperties.AutomationId="AdvancedCalibrationExpander">
                                             <StackPanel Margin="0,10,0,0">
                                                 <TextBlock Margin="0,0,0,7"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="主流程只需确认素材；缩放和偏移用于需要时的细调。" />
                                                 <UniformGrid Columns="3">
                                                     <TextBox Margin="0,0,6,0"
                                                              Style="{StaticResource FieldTextBoxStyle}"
                                                              ToolTip="缩放比例，例如 1.08"
                                                              Text="{Binding CalibrationScaleInput, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.AutomationId="CalibrationScaleInput" />
                                                     <TextBox Margin="0,0,6,0"
                                                              Style="{StaticResource FieldTextBoxStyle}"
                                                              ToolTip="水平偏移"
                                                              Text="{Binding CalibrationOffsetXInput, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.AutomationId="CalibrationOffsetXInput" />
                                                     <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                              ToolTip="垂直偏移"
                                                              Text="{Binding CalibrationOffsetYInput, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.AutomationId="CalibrationOffsetYInput" />
                                                 </UniformGrid>
                                             </StackPanel>
                                         </Expander>
                                         <TextBlock Margin="0,16,0,7"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Text="规则 · 选图要求" />
                                         <TextBox MinHeight="58"
                                                  IsEnabled="{Binding CanEditCalibration}"
                                                  Style="{StaticResource FieldTextBoxStyle}"
                                                  ToolTip="用中文描述当前框需要的素材，例如：正面全身图，商品主体完整"
                                                  Text="{Binding CalibrationRequirementInput, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 InputMethod.IsInputMethodEnabled="True"
                                                 AutomationProperties.AutomationId="CalibrationRequirementInput" />
                                        <Button Margin="0,10,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ApplyCalibrationGeometryCommand}"
                                                IsEnabled="{Binding CanEditCalibration}"
                                                Content="应用布局与规则"
                                                AutomationProperties.AutomationId="ApplyCalibrationGeometryButton" />
                                        <TextBlock Margin="0,22,0,7"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Text="已登记素材" />
                                        <ListBox MaxHeight="150"
                                                 ItemsSource="{Binding CalibrationDraft.Assets}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 PreviewMouseLeftButtonDown="CalibrationAssetList_MouseLeftButtonDown"
                                                 PreviewMouseMove="CalibrationAssetList_MouseMove"
                                                 AutomationProperties.AutomationId="CalibrationAssetList">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                     </StackPanel>
                                     </ScrollViewer>
                                     </Grid>
                                 </Border>
                             </Grid>
                             <Border Grid.Row="5"
                                     Margin="0,12,0,0"
                                     Padding="12,9"
                                     Background="{StaticResource SurfaceSubtleBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     AutomationProperties.AutomationId="CalibrationStatusBar">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding CalibrationDraft.StatusMessage}"
                                                TextTrimming="CharacterEllipsis" />
                                     <TextBlock Grid.Column="1"
                                                Margin="16,0,0,0"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding CalibrationZoomText}"
                                                TextTrimming="CharacterEllipsis" />
                                 </Grid>
                             </Border>
                         </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="{Binding PageTitle}"
                                               AutomationProperties.AutomationId="PlaceholderPageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding PageSubtitle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding PrimaryActionText}"
                                        Visibility="{Binding HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                Padding="24"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding EmptyTitle}" />
                                <ItemsControl Margin="0,18,0,0"
                                              ItemsSource="{Binding PageRows}"
                                              AutomationProperties.AutomationId="SettingsSectionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="48"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="20"
              Background="#66000000"
              Visibility="{Binding IsDuplicateReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="DuplicatePsdReviewDialog"
              AutomationProperties.Name="重复 PSD 确认"
              AutomationProperties.LiveSetting="Assertive">
            <Border Width="500"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="检测到内容相同的 PSD" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="系统不会自动删除任何源文件。请选择这次导入应如何处理："
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="{Binding DuplicateExistingLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="复用模板库中已经验证的应用内部副本。" />
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="Medium"
                                       Text="{Binding DuplicateImportedLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="保留本次复制，作为独立页面继续检查。" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDuplicateCommand}"
                                Content="取消本次导入"
                                AutomationProperties.AutomationId="CancelDuplicateButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding KeepImportedDuplicateCommand}"
                                Content="保留本次导入"
                                AutomationProperties.AutomationId="KeepImportedDuplicateButton" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding KeepExistingDuplicateCommand}"
                                Content="复用已有副本"
                                AutomationProperties.AutomationId="ReuseExistingDuplicateButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Height="64"
                Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="ActiveTaskBar">
            <Grid Margin="24,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="恢复验证任务" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="需要恢复 · 上次安全检查点" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="只读投影" />
            </Grid>
        </Border>
    </Grid>
</Window>
