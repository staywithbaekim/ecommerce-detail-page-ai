<Window x:Class="Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="电商详情页智能生产系统"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DesktopMainWindow">
    <Window.Resources>
        <Style x:Key="ShellInteractionStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOpen, ElementName=ModalHost}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BatchPageModalStyle" TargetType="local:BatchPageSelectionDialog">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsBatchPageSelectionVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsBatchInputVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TemplateConfirmationModalStyle" TargetType="local:TemplateConfirmationDialog">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsTemplateDialogVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsTemplateSectionVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DuplicateReviewModalStyle" TargetType="local:DuplicateReviewDialog">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDuplicateReviewVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsTemplateSectionVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CandidatePreviewModalStyle" TargetType="local:AiCandidatePreviewDialog">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAiCandidatePreviewVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsAiAnalysisVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAiCandidatePreviewVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsAiStyleReviewVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstanceSelectionModalStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsInstanceSelectionVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsAiAnalysisVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsInstanceSelectionVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsAiStyleReviewVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SizeTableEditorModalStyle" TargetType="local:SizeTableEditorDialog">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSizeTableEditorVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsResultOverviewVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSizeTableEditorVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsResultDetailVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UploadConsentModalStyle" TargetType="local:AiUploadConsentDialog">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAiUploadConsentDialogVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsBatchInputVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding IsBatchScanConsentPending}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAiUploadConsentDialogVisible}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsTemplateSectionVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding IsReferenceLearningConsentPending}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="TaskRowTemplate">
            <Border Height="72"
                    Style="{StaticResource TaskRowCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   Text="{Binding TaskName}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="批次记录"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusLight"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource StatusAnalyzingBrush}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                    ToolTip="{Binding StatusDescription}"
                                    AutomationProperties.HelpText="{Binding StatusDescription}">
                            <TextBlock FontSize="13"
                                       Text="{Binding StatusText}"
                                       AutomationProperties.AutomationId="TaskRowStatus"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Margin="0,2,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding StatusDetail}"
                                       AutomationProperties.AutomationId="TaskRowCounts"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="6"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding UpdatedText}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="8"
                            MinWidth="68"
                            Height="32"
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding ActionText}"
                            Command="{Binding DataContext.RestoreTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            CommandParameter="{Binding BatchId}"
                            AutomationProperties.AutomationId="{Binding BatchId, StringFormat=RestoreTask_{0}}"
                            AutomationProperties.Name="{Binding RestoreActionAccessibleName}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Completed">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Paused">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusPausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Recoverable">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}"
          AutomationProperties.AutomationId="DesktopShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ShellContent" Grid.Row="0" Style="{StaticResource ShellInteractionStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="16,20,16,16"
                                AutomationProperties.AutomationId="ApplicationBrand">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   Text="电商详情页" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="智能生产系统" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                    <Border Grid.Row="2" Margin="8,16,8,16">
                        <ListBox x:Name="PrimaryNavigationList"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.AutomationId="PrimaryNavigation">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <DockPanel LastChildFill="False" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemChrome"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFooterNavigation}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Glyph}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="PageScrollViewer">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTemplateCalibrationVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAiAnalysisVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAiStyleReviewVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResultOverviewVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResultDetailVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid Margin="32"
                      AutomationProperties.AutomationId="PageContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="{Binding BatchInputPageViewModel.Coordinator.BatchSwitchStatusText}"
                               AutomationProperties.AutomationId="BatchSwitchStatus"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SmallBodyTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BatchInputPageViewModel.Coordinator.BatchSwitchStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Row="1">
                    <Grid Visibility="{Binding IsWorkbenchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="248" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="工作台"
                                               AutomationProperties.AutomationId="PageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               LineHeight="22"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="继续活动任务或开始新的批量生产" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="120"
                                            Margin="0,11,8,11"
                                            Command="{Binding RestoreBatchInputCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="恢复上次批次"
                                            AutomationProperties.AutomationId="RestoreLatestBatchAction"
                                            AutomationProperties.Name="恢复上次批次" />
                                    <Button Width="120"
                                            Margin="0,11,0,11"
                                            Command="{Binding OpenBatchInputCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            AutomationProperties.AutomationId="PrimaryPageAction"
                                            AutomationProperties.Name="新建批次">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Text="&#xE710;" />
                                            <TextBlock VerticalAlignment="Center" Text="新建批次" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DockPanel Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Command="{Binding RefreshTasksCommand}" Content="刷新列表"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="RefreshWorkbenchTasksAction" />
                                <Button Command="{Binding ShowTasksCommand}" Content="查看全部任务" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="ShowAllTasksAction" />
                            </StackPanel>
                            <TextBlock Text="{Binding TaskListStatusText}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Style="{StaticResource SmallBodyTextStyle}"
                                       AutomationProperties.AutomationId="WorkbenchTaskListStatus"
                                       AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>

                        <StackPanel Grid.Row="2" Margin="0,24,0,0"
                                    Visibility="{Binding HasActiveTasks, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="WorkbenchAttentionSection">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="待继续 / 待处理" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="按已保存状态列出最近3条；请打开核对，不会自动继续执行。" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding ActiveTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AutomationProperties.AutomationId="ActiveTaskList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,12" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,24,0,0">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="最近任务" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding ShowEmptyRecentTasks, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="WorkbenchNoRecentTasks"
                                       Text="暂无最近任务" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding RecentTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AlternationCount="3"
                                          AutomationProperties.AutomationId="RecentTaskList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,12" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                <Setter Property="FrameworkElement.Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="RecoveryFixturePanel">
                            <TextBlock Margin="0,0,0,8" Text="任务名称" />
                            <TextBox Width="360"
                                     Height="40"
                                     HorizontalAlignment="Left"
                                     Padding="10,7"
                                     InputMethod.IsInputMethodEnabled="True"
                                     AutomationProperties.AutomationId="ChineseImeFixtureInput" />
                        </StackPanel>
                    </Grid>

                    <local:BatchInputPage DataContext="{Binding BatchInputPageViewModel}" />
                    <local:AiAnalysisPage />
                    <local:ResultReviewPage DataContext="{Binding ResultReviewPageViewModel}" />
                    <local:TemplateWorkspacePage DataContext="{Binding TemplateWorkspacePageViewModel}" />
                    <local:SettingsPage x:Name="SettingsPage" DataContext="{Binding SettingsPageViewModel}" />
                    <Grid Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="{Binding PageTitle}"
                                               AutomationProperties.AutomationId="PlaceholderPageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding PageSubtitle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Command="{Binding RefreshTasksCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="刷新列表"
                                            AutomationProperties.AutomationId="RefreshTaskListAction" />
                                    <Button Margin="8,0,0,0" Command="{Binding OpenBatchInputCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" Content="新建批次"
                                            ToolTip="扫描、分析或生成中不可切换；请等待当前操作收口或安全暂停。"
                                            ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.AutomationId="TaskNewBatchAction" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                Padding="24"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding TaskListStatusText}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="TaskListStatus" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="选择任务查看已保存内容；不会自动继续处理。" />
                                <ItemsControl Margin="0,18,0,0"
                                              ItemsSource="{Binding Tasks}"
                                              ItemTemplate="{StaticResource TaskRowTemplate}"
                                              AutomationProperties.AutomationId="RecoverableTaskList">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Margin" Value="0,0,0,12" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>


        <Border Grid.Row="1" Style="{StaticResource ShellInteractionStyle}"
                Height="64"
                Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="ActiveTaskBar">
            <Grid Margin="24,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="恢复验证任务" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="需要恢复 · 上次安全检查点" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="只读投影" />
            </Grid>
        </Border>
        <!-- Last root child spans the complete window, outside every page and ScrollViewer. -->
        <local:ModalHost x:Name="ModalHost" Grid.RowSpan="2"
                         AutomationProperties.AutomationId="ModalHost">
            <local:BatchPageSelectionDialog DataContext="{Binding BatchInputPageViewModel}"
                                            Style="{StaticResource BatchPageModalStyle}" />
            <local:DuplicateReviewDialog DataContext="{Binding TemplateWorkspacePageViewModel}"
                                         Style="{StaticResource DuplicateReviewModalStyle}" />
            <local:TemplateConfirmationDialog DataContext="{Binding TemplateWorkspacePageViewModel}"
                                              Style="{StaticResource TemplateConfirmationModalStyle}" />
            <local:AiCandidatePreviewDialog DataContext="{Binding AiAnalysisPageViewModel}"
                                            Style="{StaticResource CandidatePreviewModalStyle}" />
            <local:SizeTableEditorDialog DataContext="{Binding SizeTableEditorPage}"
                                         Style="{StaticResource SizeTableEditorModalStyle}" />
            <Border Background="#AA000000" Style="{StaticResource InstanceSelectionModalStyle}" DataContext="{Binding AiAnalysisPageViewModel}"
                    AutomationProperties.AutomationId="InstanceSelectionDialog">
                <Border Width="640" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyTextStyle}" Text="选择需要锁定用图的输出实例" />
                        <TextBlock Margin="0,8,0,12" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Text="仅修改选中的实例。列表来自已登记的本款素材与颜色事实；确认后保存此实例的选图，生成时冻结。" />
                        <ComboBox ItemsSource="{Binding InstanceSelectionTargets}" SelectedItem="{Binding SelectedInstanceTarget}"
                                  DisplayMemberPath="Label" AutomationProperties.AutomationId="InstanceSelectionTarget" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding SelectedInstanceTarget.Label, StringFormat=当前选图：{0}}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="已保存的选图只作用于当前实例。" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="取消" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding CancelInstanceSelectionCommand}" />
                            <Button Content="确认此实例" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmInstanceSelectionCommand}"
                                    AutomationProperties.AutomationId="ConfirmInstanceSelection" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
            <local:AiUploadConsentDialog DataContext="{Binding AiAnalysisPageViewModel}"
                                          Style="{StaticResource UploadConsentModalStyle}" />
        </local:ModalHost>
    </Grid>
</Window>
