                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="64" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="16,10,16,8">
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="模板页面" />
