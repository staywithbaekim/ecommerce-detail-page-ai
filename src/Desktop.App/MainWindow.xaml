<Window x:Class="Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="电商详情页智能生产系统"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DesktopMainWindow">
    <Window.Resources>
        <!-- Shared by the inline summary and the standalone style-review page. -->
        <Style x:Key="AiStyleStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Analysing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Ready"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="ReviewRequired"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="BudgetStopped"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="BusinessError"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="SystemError"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiRequirementStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Analysing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="AiSelected"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="ManualLocked"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Missing"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Unavailable"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="TaskRowTemplate">
            <Border Height="68"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   LineHeight="18"
                                   Text="{Binding TaskName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding TemplateName}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusLight"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource StatusAnalyzingBrush}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="6"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding UpdatedText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{Binding ActionText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Completed">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Paused">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusPausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Recoverable">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TemplateLibraryCardTemplate">
            <Button Margin="0,0,0,12"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    FocusVisualStyle="{StaticResource VisibleFocusStyle}"
                    AutomationProperties.Name="{Binding Name}">
                <Border Height="76"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52"
                                Height="52"
                                Background="{StaticResource SurfaceStrongBrush}"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="20"
                                       Text="&#xE8A5;" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource SmallBodyTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding Meta}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SmallBodyTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding UpdatedText}" />
                        <StackPanel Grid.Column="4"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource StatusDraftBrush}" />
                            <TextBlock Text="{Binding Status}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Text="查看" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ImportedPsdTemplate">
            <Border Height="68"
                    Margin="0,0,0,12"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="68" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource StatusCompletedBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                   Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding InspectionSummary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{Binding Status}" />
                    <Button Grid.Column="4"
                            Width="56"
                            Height="30"
                            Margin="12,0,0,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource CompactButtonStyle}"
                            Command="{Binding DataContext.RemoveImportedPsdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="移除"
                            ToolTip="从当前模板草稿移除；不会删除用户源 PSD"
                            AutomationProperties.Name="移除 PSD" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TemplateDetailPageTemplate">
            <Border Height="68"
                    Padding="16"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding OrderText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#237A45"
                               Text="{Binding Status}" />
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Text="{Binding Action}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TemplatePageListItemTemplate">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="34" />
                     <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="&#xE700;" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding DisplayOrder}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding Status}" />
                </StackPanel>
                 <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Width="26"
                            Height="22"
                            MinWidth="26"
                            Margin="0,0,0,2"
                            Padding="0"
                            Style="{StaticResource CompactButtonStyle}"
                            Tag="{Binding}"
                            Click="MoveTemplatePageUp_Click"
                            AutomationProperties.Name="上移页面">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70E;" />
                    </Button>
                    <Button Width="26"
                            Height="22"
                            MinWidth="26"
                            Padding="0"
                            Style="{StaticResource CompactButtonStyle}"
                            Tag="{Binding}"
                            Click="MoveTemplatePageDown_Click"
                            AutomationProperties.Name="下移页面">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" />
                     </Button>
                 </StackPanel>
                 <Button Grid.Column="4"
                         Width="52"
                         Height="30"
                         Margin="8,0,0,0"
                         Padding="0"
                         VerticalAlignment="Center"
                         Style="{StaticResource CompactButtonStyle}"
                         Command="{Binding DataContext.RemoveTemplatePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         IsEnabled="{Binding CanRemove}"
                         Content="移除"
                         AutomationProperties.Name="移除模板页面" />
             </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}"
          AutomationProperties.AutomationId="DesktopShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="16,20,16,16"
                                AutomationProperties.AutomationId="ApplicationBrand">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   Text="电商详情页" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="智能生产系统" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                    <Border Grid.Row="2" Margin="8,16,8,16">
                        <ListBox x:Name="PrimaryNavigationList"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.AutomationId="PrimaryNavigation">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <DockPanel LastChildFill="False" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemChrome"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F1F1F2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFooterNavigation}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Glyph}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="PageScrollViewer">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTemplateCalibrationVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAiAnalysisVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAiStyleReviewVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResultOverviewVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResultDetailVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid Margin="32"
                      AutomationProperties.AutomationId="PageContent">
                    <Grid Visibility="{Binding IsWorkbenchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="264" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="248" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="工作台"
                                               AutomationProperties.AutomationId="PageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               LineHeight="22"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="继续活动任务或开始新的批量生产" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Width="120"
                                            Margin="0,11,8,11"
                                            Command="{Binding RestoreBatchInputCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="恢复上次批次"
                                            AutomationProperties.AutomationId="RestoreLatestBatchAction"
                                            AutomationProperties.Name="恢复上次批次" />
                                    <Button Width="120"
                                            Margin="0,11,0,11"
                                            Command="{Binding OpenBatchInputCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            AutomationProperties.AutomationId="PrimaryPageAction"
                                            AutomationProperties.Name="新建批次">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Text="&#xE710;" />
                                            <TextBlock VerticalAlignment="Center" Text="新建批次" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="进行中" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding ActiveTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AutomationProperties.AutomationId="ActiveTaskList" />
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="最近任务" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding RecentTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AlternationCount="3"
                                          AutomationProperties.AutomationId="RecentTaskList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,12" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                <Setter Property="FrameworkElement.Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="RecoveryFixturePanel">
                            <TextBlock Margin="0,0,0,8" Text="任务名称" />
                            <TextBox Width="360"
                                     Height="40"
                                     HorizontalAlignment="Left"
                                     Padding="10,7"
                                     InputMethod.IsInputMethodEnabled="True"
                                     AutomationProperties.AutomationId="ChineseImeFixtureInput" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsBatchInputVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="BatchInputPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="64" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" MinHeight="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="新建批次 / 扫描前设置" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource PageTitleTextStyle}"
                                           Text="新建批次"
                                           AutomationProperties.AutomationId="BatchInputTitle" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource SmallBodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="确认模板、商品目录、输出位置和本批次页面" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="16,6,0,0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <TextBlock Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="&#xE823;" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding BatchDraftSaveText}"
                                           AutomationProperties.AutomationId="BatchDraftSaveStatus" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" AutomationProperties.AutomationId="BatchInputForm">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="模板与目录" />
                                <TextBlock Margin="0,4,0,12"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="选择已校准模板，并确认本批次的输入与正式输出位置" />

                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="模板组" />
                                <ComboBox Margin="0,6,0,0"
                                          ItemsSource="{Binding BatchTemplateGroups}"
                                          SelectedItem="{Binding SelectedBatchTemplate, Mode=TwoWay}"
                                          IsEnabled="{Binding IsBatchConfigurationEditable}"
                                          Style="{StaticResource FieldComboBoxStyle}"
                                          AutomationProperties.AutomationId="BatchTemplateSelect"
                                          AutomationProperties.Name="模板组">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding BatchTemplateHelperText}" />

                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CreateTemplateFromBatchCommand}"
                                            Content="新建模板组"
                                            AutomationProperties.AutomationId="CreateTemplateFromBatchButton" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding ImportTemplateFromBatchCommand}"
                                            Content="导入已校准模板"
                                            AutomationProperties.AutomationId="ImportTemplateFromBatchButton" />
                                </StackPanel>

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Text="商品目录" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             IsReadOnly="True"
                                             Text="{Binding BatchInputDirectoryDisplay, Mode=OneWay}"
                                             AutomationProperties.AutomationId="BatchInputDirectoryField"
                                             AutomationProperties.Name="商品目录" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseBatchInputDirectoryCommand}"
                                            Content="选择目录"
                                            AutomationProperties.AutomationId="ChooseBatchInputDirectoryButton" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusDraftBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="{Binding BatchRecognitionText}"
                                               AutomationProperties.AutomationId="BatchRecognitionStatus"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Grid>

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Text="正式输出目录" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             IsReadOnly="True"
                                             Text="{Binding BatchOutputDirectoryDisplay, Mode=OneWay}"
                                             AutomationProperties.AutomationId="BatchOutputDirectoryField"
                                             AutomationProperties.Name="正式输出目录" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseBatchOutputDirectoryCommand}"
                                            Content="选择目录"
                                            AutomationProperties.AutomationId="ChooseBatchOutputDirectoryButton" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusDraftBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="{Binding BatchOutputConfirmationText}"
                                               AutomationProperties.AutomationId="BatchOutputConfirmationStatus" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="生成设置" />
                                <TextBlock Margin="0,4,0,12"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="设置本批次的选图方式、页面范围与输出格式" />

                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="选图方式" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0"
                                                 GroupName="BatchSelectionMode"
                                                 Style="{StaticResource FieldRadioCardStyle}"
                                                 IsEnabled="{Binding IsBatchConfigurationEditable}"
                                                 IsChecked="{Binding IsBatchAutomaticSelection, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="BatchAutomaticSelectionOption"
                                                 AutomationProperties.Name="AI 自动选图">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="AI 自动选图" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="自动分析并匹配每个图片框" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="2"
                                                 GroupName="BatchSelectionMode"
                                                 Style="{StaticResource FieldRadioCardStyle}"
                                                 IsEnabled="{Binding IsBatchConfigurationEditable}"
                                                 IsChecked="{Binding IsBatchManualSelection, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="BatchManualSelectionOption"
                                                 AutomationProperties.Name="人工选图">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="人工选图" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="由用户选图，后续仍可智能适配" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource SectionCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                                       Text="{Binding BatchPageSelectionSummary}"
                                                       AutomationProperties.AutomationId="BatchPageSelectionSummary" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="取消页面只影响当前批次" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenBatchPageSelectionCommand}"
                                                Content="选择页面"
                                                AutomationProperties.AutomationId="OpenBatchPageSelectionButton" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,12,0,0" Style="{StaticResource SectionCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="同时输出可编辑 PSD" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="默认关闭；开启后不适用 5 分钟性能目标" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  IsEnabled="{Binding IsBatchConfigurationEditable}"
                                                  IsChecked="{Binding BatchIncludeEditablePsd, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="BatchEditablePsdToggle"
                                                  AutomationProperties.Name="同时输出可编辑 PSD" />
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,14,0,8"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Text="输出结构预览" />
                                <Border Padding="16,12"
                                        Background="{StaticResource SurfaceSubtleBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="款式目录\" />
                                        <ItemsControl Margin="0,4,0,0"
                                                      ItemsSource="{Binding BatchOutputPreviewFiles}"
                                                      AutomationProperties.AutomationId="BatchOutputPreviewFiles">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,2"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="{Binding BatchOutputPreviewSummary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="4"
                                Margin="0,12,0,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                AutomationProperties.AutomationId="BatchInputFooter">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusDraftBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BatchStatusState}" Value="Scanning">
                                                    <Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BatchStatusState}" Value="ScanReady">
                                                    <Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BatchStatusState}" Value="ScanBlocked">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SmallBodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding BatchStatusMessage}"
                                           AutomationProperties.AutomationId="BatchInputStatus"
                                           AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding CancelBatchInputCommand}"
                                        Content="取消"
                                        AutomationProperties.AutomationId="CancelBatchInputButton" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RetryBatchScanCommand}"
                                        Content="重试扫描"
                                        Visibility="{Binding HasBatchRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="RetryBatchScanButton" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding CancelBatchScanCommand}"
                                        Content="取消扫描"
                                        Visibility="{Binding IsBatchScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="CancelBatchScanButton" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ScanBatchInputCommand}"
                                        Content="{Binding BatchPrimaryActionText}"
                                        AutomationProperties.AutomationId="ScanBatchInputButton"
                                        AutomationProperties.Name="{Binding BatchPrimaryActionText}" />
                            </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsAiAnalysisVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="AiAnalysisPage">
                        <Grid.Resources>
                            <Style x:Key="AiFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactButtonStyle}">
                                <Setter Property="MinWidth" Value="64" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="AiStyleStatusDotStyle" TargetType="Ellipse">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Analysing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Ready"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="ReviewRequired"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="BudgetStopped"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="BusinessError"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="SystemError"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="AiFilterDotStyle" TargetType="Ellipse">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="Processing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Review"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Ready"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="Blocked"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style x:Key="AiRequirementStatusDotStyle" TargetType="Ellipse">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Analysing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="AiSelected"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="ManualLocked"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Missing"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusState}" Value="Unavailable"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="116" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="{Binding AiSummaryHeight}" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,10,28,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="新建批次 / 生成前" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource PageTitleTextStyle}"
                                           Text="{Binding AiPageTitle}"
                                           AutomationProperties.AutomationId="AiAnalysisTitle" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource SmallBodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding AiPageSubtitle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{Binding AiPrimaryActionText}"
                                    Command="{Binding PrepareRenderingCommand}"
                                    IsEnabled="{Binding IsAiReady}"
                                    AutomationProperties.AutomationId="EnterGenerationButton" />
                        </Grid>

                        <Border Grid.Row="2" Padding="0" Style="{StaticResource SectionCardStyle}" AutomationProperties.AutomationId="AiAnalysisSummary">
                            <UniformGrid Columns="{Binding AiSummaryColumnCount}">
                                <StackPanel Margin="20,8" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="模板组" />
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AiTemplateSummary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AiTemplateMeta}" />
                                </StackPanel>
                                <StackPanel Margin="20,8" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="输入批次" />
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AiBatchSummary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AiBatchMeta}" />
                                </StackPanel>
                                <StackPanel Margin="20,8" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="输出设置" />
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AiOutputSummary}" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AiOutputMeta}" />
                                </StackPanel>
                                <StackPanel Margin="20,8" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="页面生成" />
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding AiPageSummary}" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AiPageMeta}" />
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <Grid Grid.Row="4" Visibility="{Binding IsAiRegularState, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="40" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="16,0" Style="{StaticResource SectionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource AiStyleStatusDotStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding AiBatchProgressText}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding AiStatusMessage}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AiAnalysisStatus" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="刷新状态" Command="{Binding RefreshAiAnalysisCommand}" AutomationProperties.AutomationId="RefreshAiAnalysisButton" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Text="{Binding AiBatchProgressText}" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding AiStatusFilters}" AutomationProperties.AutomationId="AiStatusFilters">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource AiFilterButtonStyle}"
                                                    Command="{Binding DataContext.SelectAiStatusFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource AiFilterDotStyle}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding DisplayText}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AiAnalysisScrollViewer">
                                <ItemsControl ItemsSource="{Binding VisibleAiStyles}" AutomationProperties.AutomationId="AiStyleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="16,0"
                                                    Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    AutomationProperties.Name="款式检查摘要">
                                                    <Grid>
                                                    <Grid Height="{Binding DataContext.AiStyleRowHeight, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="40" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" VerticalAlignment="Center" Background="{StaticResource SurfaceStrongBrush}" CornerRadius="6">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextDisabledBrush}" Text="▧" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding StyleName}" />
                                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding MetaText}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Margin="0,0,6,0" Style="{StaticResource AiStyleStatusDotStyle}" />
                                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusText}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="4"
                                                                Width="32"
                                                                Height="32"
                                                                MinWidth="32"
                                                                Padding="0"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                Content="&gt;"
                                                                Command="{Binding DataContext.OpenAiStyleReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="进入款式检查" />
                                                    </Grid>
                                                <Grid Height="{Binding DataContext.AiStyleReviewHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Margin="16,0,16,12"
                                                      Visibility="Collapsed"
                                                      AutomationProperties.AutomationId="AiStyleReviewTwoPane">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*" MinWidth="420" />
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="2*" MinWidth="280" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Padding="16" Style="{StaticResource SectionCardStyle}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="52" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="本款全部用图" />
                                                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding UsageSummaryText}" />
                                                            </StackPanel>
                                                            <ScrollViewer Grid.Row="1"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Visible"
                                                                          PanningMode="VerticalOnly"
                                                                          AutomationProperties.AutomationId="AiCurrentUsageScrollViewer"
                                                                          AutomationProperties.Name="本款全部用图，可向下滚动">
                                                                <ItemsControl ItemsSource="{Binding Pages}" AutomationProperties.AutomationId="AiPageList">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,0,10,12">
                                                                                <Grid Margin="4,0,4,8">
                                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding PageName}" />
                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                        <Ellipse Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource AiStyleStatusDotStyle}" />
                                                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusText}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                                <ItemsControl Margin="4,0,4,6"
                                                                                              ItemsSource="{Binding WarningTexts}"
                                                                                              Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Margin="0,0,0,4" Style="{StaticResource CaptionTextStyle}" Text="{Binding}" TextWrapping="Wrap" />
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <ItemsControl ItemsSource="{Binding Requirements}" AutomationProperties.AutomationId="AiRequirementUsageList">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Height="{Binding DataContext.AiRequirementRowHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                    Margin="0,0,0,8"
                                                                                                    Padding="8"
                                                                                                    Background="{StaticResource SurfaceSubtleBrush}"
                                                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                                                    BorderThickness="1"
                                                                                                    CornerRadius="6">
                                                                                                <Border.Style>
