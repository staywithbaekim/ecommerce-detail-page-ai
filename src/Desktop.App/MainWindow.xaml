                                                                VerticalContentAlignment="Stretch"
                                                                Style="{StaticResource CompactButtonStyle}"
                                                                Command="{Binding DataContext.OpenResultPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.Name="{Binding PageName, StringFormat=打开页面检查：{0}}">
                                                            <Grid>
                                                                <Grid.RowDefinitions><RowDefinition Height="148" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                                <Grid Background="{StaticResource SurfaceStrongBrush}" ClipToBounds="True">
                                                                    <Image Source="{Binding PreviewPath}" Stretch="Uniform" Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="无正式结果预览" Visibility="{Binding HasNoPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <Border Height="24" VerticalAlignment="Bottom" Background="#CC171717">
                                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="11" Text="{Binding OutputBoundaryText}" TextTrimming="CharacterEllipsis" />
                                                                    </Border>
                                                                </Grid>
                                                                <Grid Grid.Row="1" Margin="12,8">
                                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{Binding PageName}" TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
                                                                        <Ellipse Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource ResultStatusDotStyle}" />
                                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusText}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Visibility="{Binding IsResultDetailVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="ResultDetailPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="60" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Button Width="104"
                                    Height="36"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="&lt; 结果检查"
                                    Command="{Binding ReturnToResultOverviewCommand}"
                                    AutomationProperties.AutomationId="ReturnToResultOverviewButton" />
                            <StackPanel Grid.Column="1" Margin="16,0,16,0">
                                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding SelectedResultPage.PageName}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ResultDetailTitle" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource SmallBodyTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="{Binding SelectedResultPage.StyleName}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Width="128"
                                    Height="36"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="重新生成此页"
                                    IsEnabled="False"
                                    ToolTip="尚无正式 Photoshop 渲染能力；不能提交页级修复。"
                                    AutomationProperties.AutomationId="RegenerateResultPageButton" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ResultCandidateColumnWidth}" />
                                <ColumnDefinition Width="{Binding ResultDetailGutterWidth}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{Binding ResultDetailGutterWidth}" />
                                <ColumnDefinition Width="{Binding ResultAdjustmentColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Padding="14"
                                    Style="{StaticResource SectionCardStyle}"
                                    AutomationProperties.AutomationId="ResultCandidatePanel">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="候选素材" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="只读显示当前页面候选关系" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ResultCandidateScrollViewer">
                                        <ItemsControl Margin="0,0,8,0"
                                                      ItemsSource="{Binding SelectedResultPage.Candidates}"
                                                      AutomationProperties.AutomationId="ResultCandidateList">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="{x:Type ContentPresenter}">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="118"
                                                            Margin="0,0,0,8"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            AutomationProperties.Name="{Binding AutomationName}">
                                                        <Grid>
                                                            <Image Source="{Binding PreviewPath}"
                                                                   Stretch="UniformToFill"
                                                                   AutomationProperties.Name="{Binding AutomationName}" />
                                                            <Border Height="34" VerticalAlignment="Bottom" Background="#CC171717">
                                                                <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Foreground="White" FontSize="11" Text="{Binding RankText}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="White" FontSize="11" Text="{Binding StateText}" /></Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2"
                                    Padding="16"
                                    Style="{StaticResource SectionCardStyle}"
                                    AutomationProperties.AutomationId="ResultPagePreviewPanel">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="页面检查" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding SelectedResultPage.OutputBoundaryText}" />
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="{StaticResource SurfaceStrongBrush}" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <Image Margin="12" Source="{Binding SelectedResultPage.PreviewPath}" Stretch="Uniform" Visibility="{Binding SelectedResultPage.HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedResultPage.HasNoPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitleTextStyle}" Text="没有正式输出" />
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="业务红页不会显示虚构结果图" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource StatusPausedBrush}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource SmallBodyTextStyle}" Text="{Binding SelectedResultPage.DetailText}" TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="4"
                                    Padding="14"
                                    Style="{StaticResource SectionCardStyle}"
                                    AutomationProperties.AutomationId="ResultAdjustmentPanel">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="当前页调整" />
                                    <TextBlock Margin="0,4,0,16" Style="{StaticResource CaptionTextStyle}" Text="AI-01 只交付计划边界；正式单页修复属于 REPAIR-01。" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="移动与缩放" />
                                    <Slider Margin="0,8,0,16" IsEnabled="False" Value="50" AutomationProperties.Name="页面缩放，尚未启用" />
                                     <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="自然语言调整" />
                                     <TextBox Height="72" Margin="0,8,0,8" IsEnabled="False" Text="尚未启用" AutomationProperties.Name="自然语言调整，尚未启用" />
                                     <Button Margin="0,0,0,8"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                             Content="编辑尺码数据"
                                             Command="{Binding OpenSizeTableEditorCommand}"
                                             CommandParameter="{Binding SelectedResultPage}"
                                             Visibility="{Binding SelectedResultPage.IsSizeTablePage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                             AutomationProperties.AutomationId="EditSizeTableDataButton" />
                                     <Button Style="{StaticResource SecondaryButtonStyle}" Content="在 Photoshop 中编辑此页" IsEnabled="False" AutomationProperties.AutomationId="EditResultPageInPhotoshopButton" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource StatusPausedBrush}" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="单页操作不会更新模板规则；未执行渲染时不会写入正式输出。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="76" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Content="上一页" Command="{Binding PreviousResultPageCommand}" AutomationProperties.AutomationId="PreviousResultPageButton" />
                                    <Button Width="76" Style="{StaticResource SecondaryButtonStyle}" Content="下一页" Command="{Binding NextResultPageCommand}" AutomationProperties.AutomationId="NextResultPageButton" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsTemplateSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="TemplateWorkspace">
                        <!-- T-01: template library and detail use real application projections. -->
                        <Grid Visibility="{Binding IsTemplateLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateLibraryPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                               Text="模板库"
                                               AutomationProperties.AutomationId="TemplateLibraryTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="查找、维护和迁移已校准模板组" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,11,8,11"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ImportTemplatePackageCommand}"
                                            Content="导入已校准模板"
                                            AutomationProperties.AutomationId="ImportTemplatePackageButton" />
                                    <Button Margin="0,11,0,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding NewTemplateCommand}"
                                            AutomationProperties.AutomationId="NewTemplateGroupButton"
                                            AutomationProperties.Name="新建模板组">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Text="&#xE710;" />
                                            <TextBlock Text="新建模板组" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <StackPanel Visibility="{Binding HasTemplateGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="{Binding TemplateGroups.Count, StringFormat={}{0} 个模板组}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="按最近更新排序" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TemplateGroups}"
                                                  ItemTemplate="{StaticResource TemplateLibraryCardTemplate}"
                                                  AutomationProperties.AutomationId="TemplateGroupList" />
                                </StackPanel>

                                <Border Padding="48,64"
                                        Style="{StaticResource SectionCardStyle}"
                                        Visibility="{Binding IsTemplateLibraryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="TemplateLibraryEmptyState">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource SurfaceStrongBrush}"
                                                CornerRadius="24">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="22"
                                                       Text="&#xE8A5;" />
                                        </Border>
                                        <TextBlock Margin="0,18,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="尚无模板组" />
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="从一个或多个 PSD 开始建立可重复使用的模板页面。" />
                                        <Button Margin="0,22,0,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding NewTemplateCommand}"
                                                Content="新建模板组"
                                                AutomationProperties.AutomationId="EmptyNewTemplateGroupButton" />
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateDetailsPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                             <Grid>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Width="84"
                                            Height="28"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding BackToTemplateLibraryCommand}"
                                            Content="← 返回"
                                            AutomationProperties.AutomationId="BackToTemplateLibraryButton" />
                                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                               Text="{Binding TemplateDetailsTitle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource SmallBodyTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateDetailsMeta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                             Foreground="{StaticResource DangerBrush}"
                                             Content="删除"
                                            Command="{Binding DeleteTemplateCommand}"
                                            AutomationProperties.AutomationId="DeleteTemplateGroupButton" />
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="另存为"
                                            Command="{Binding SaveTemplateAsCommand}"
                                            AutomationProperties.AutomationId="SaveTemplateAsButton" />
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="导出"
                                            Command="{Binding ExportTemplateCommand}"
                                            AutomationProperties.AutomationId="ExportTemplatePackageButton" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddTemplatePagesCommand}"
                                            IsEnabled="{Binding CanIncrementTemplate}"
                                            Content="添加模板页面"
                                            AutomationProperties.AutomationId="AddTemplatePagesButton" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="模板页面" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="页面顺序决定详情页输出顺序" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TemplateDetailPages}"
                                                  ItemTemplate="{StaticResource TemplateDetailPageTemplate}"
                                                  AutomationProperties.AutomationId="TemplateDetailPageList" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- T-02: source selection stays read-only; only application-owned copies are passed to the workspace service. -->
                        <Grid Visibility="{Binding IsTemplateImportVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplatePsdImportPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="64" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Button Height="22"
                                        MinWidth="0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding BackToTemplateLibraryCommand}"
                                        Content="模板组 / 返回模板库"
                                        AutomationProperties.AutomationId="CancelTemplateImportButton" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PageTitleTextStyle}"
                                           Text="{Binding TemplateFlowTitle}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="导入一个或多个 PSD，并确认首次校准方式" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="1  导入模板" />
                                <Border Width="40" Height="1" Margin="12,9" Background="{StaticResource BorderBrush}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="2  页面设置" />
                                <Border Width="40" Height="1" Margin="12,9" Background="{StaticResource BorderBrush}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="3  校准" />
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                 <Border Padding="0"
                                         Background="{StaticResource SurfaceBrush}"
                                         AllowDrop="True"
                                         DragOver="PsdDropZone_DragOver"
                                         Drop="PsdDropZone_Drop"
                                         AutomationProperties.AutomationId="TemplatePsdDropZone"
                                         AutomationProperties.Name="PSD 文件拖放区域">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="模板文件" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="软件只复制 PSD 副本到模板库，不修改用户选择的源文件。" />
                                        <Border Margin="0,12,0,0"
                                                Padding="12"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="模板组名称" />
                                                <TextBox Margin="0,4,0,0"
                                                         Style="{StaticResource FieldTextBoxStyle}"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Text="{Binding TemplateGroupName, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsIncrementalTemplateDraft}"
                                                         InputMethod.IsInputMethodEnabled="True"
                                                         AutomationProperties.AutomationId="TemplateGroupNameInput"
                                                         AutomationProperties.Name="模板组名称" />
                                            </StackPanel>
                                        </Border>
                                         <Grid Margin="0,12,0,0"
                                               MinHeight="360"
                                               Cursor="Hand"
                                               MouseLeftButtonUp="PsdDropZone_MouseLeftButtonUp"
                                               AutomationProperties.AutomationId="PsdEmptyState">
                                             <Grid.Style>
                                                 <Style TargetType="Grid">
                                                     <Setter Property="Visibility" Value="Collapsed" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding HasImportedTemplateFiles}" Value="False">
                                                             <Setter Property="Visibility" Value="Visible" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Grid.Style>
                                             <StackPanel HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         MaxWidth="360">
                                                 <Border Width="48"
                                                         Height="48"
                                                         HorizontalAlignment="Center"
                                                         Background="{StaticResource SurfaceSubtleBrush}"
                                                         CornerRadius="24">
                                                     <TextBlock HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontFamily="Segoe Fluent Icons"
                                                                FontSize="22"
                                                                Foreground="{StaticResource TextBrush}"
                                                                Text="&#xE8A5;" />
                                                 </Border>
                                                 <TextBlock Margin="0,14,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="16"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource TextBrush}"
                                                            Text="尚未导入 PSD" />
                                                 <TextBlock Margin="0,6,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="从一个或多个 PSD 开始建立可重复使用的模板页面。"
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap" />
                                                  <StackPanel Margin="0,16,0,0"
                                                              HorizontalAlignment="Center"
                                                              Orientation="Horizontal">
                                                      <Button Width="120"
                                                              Height="36"
                                                              Style="{StaticResource PrimaryButtonStyle}"
                                                              Click="ChoosePsdFiles_Click"
                                                              Content="选择 PSD"
                                                              AutomationProperties.AutomationId="ChoosePsdFilesButton" />
                                                      <Button Width="120"
                                                              Height="36"
                                                              Margin="12,0,0,0"
                                                              Style="{StaticResource SecondaryButtonStyle}"
                                                              Click="ChoosePsdFolder_Click"
                                                              Content="导入文件夹"
                                                              AutomationProperties.AutomationId="ChoosePsdFolderButton" />
                                                  </StackPanel>
                                             </StackPanel>
                                         </Grid>
                                         <StackPanel Margin="0,12,0,0"
                                                     HorizontalAlignment="Left"
                                                     Orientation="Horizontal">
                                             <StackPanel.Style>
                                                 <Style TargetType="StackPanel">
                                                     <Setter Property="Visibility" Value="Collapsed" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding HasImportedTemplateFiles}" Value="True">
                                                             <Setter Property="Visibility" Value="Visible" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </StackPanel.Style>
                                             <Button Width="120"
                                                     Height="36"
                                                     Style="{StaticResource SecondaryButtonStyle}"
                                                     Click="ChoosePsdFiles_Click"
                                                     Content="添加 PSD"
                                                     AutomationProperties.AutomationId="ChooseMorePsdFilesButton" />
                                             <Button Width="120"
                                                     Height="36"
                                                     Margin="12,0,0,0"
                                                     Style="{StaticResource SecondaryButtonStyle}"
                                                     Click="ChoosePsdFolder_Click"
                                                     Content="导入文件夹"
                                                     AutomationProperties.AutomationId="ChooseMorePsdFolderButton" />
                                         </StackPanel>
                                         <ItemsControl Margin="0,12,0,0"
                                                      ItemsSource="{Binding ImportedTemplateFiles}"
                                                      ItemTemplate="{StaticResource ImportedPsdTemplate}"
                                                      AutomationProperties.AutomationId="ImportedPsdList" />
                                         <TextBlock Margin="0,2,0,0"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    Text="也可以把 PSD 直接拖到此区域；源文件始终只读。"
                                                    Visibility="{Binding HasImportedTemplateFiles, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Padding="0" Background="{StaticResource SurfaceBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="校准方式" />
                                        <TextBlock Margin="0,4,0,0"
