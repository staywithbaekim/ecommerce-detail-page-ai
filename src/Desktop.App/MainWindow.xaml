                                                                     Height="8"
                                                                     HorizontalAlignment="Left"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="-4,0,0,-4"
                                                                     Background="White"
                                                                     BorderBrush="{StaticResource TextBrush}"
                                                                     BorderThickness="1"
                                                                     IsHitTestVisible="False" />
                                                             <Border Width="8"
                                                                     Height="8"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Bottom"
                                                                     Margin="0,0,-4,-4"
