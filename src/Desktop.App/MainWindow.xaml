<Window x:Class="Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="电商详情页智能生产系统"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DesktopMainWindow">
    <Window.Resources>
        <DataTemplate x:Key="TaskRowTemplate">
            <Border Height="68"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   LineHeight="18"
                                   Text="{Binding TaskName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding TemplateName}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusLight"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource StatusAnalyzingBrush}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="6"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding UpdatedText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{Binding ActionText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Completed">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Paused">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusPausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Recoverable">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}"
          AutomationProperties.AutomationId="DesktopShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="16,20,16,16"
                                AutomationProperties.AutomationId="ApplicationBrand">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   Text="电商详情页" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="智能生产系统" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                    <Border Grid.Row="2" Margin="8,16,8,16">
                        <ListBox x:Name="PrimaryNavigationList"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.AutomationId="PrimaryNavigation">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <DockPanel LastChildFill="False" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemChrome"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F1F1F2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFooterNavigation}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Glyph}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          AutomationProperties.AutomationId="PageScrollViewer">
                <Grid Margin="32"
                      AutomationProperties.AutomationId="PageContent">
                    <Grid Visibility="{Binding IsWorkbenchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="264" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="工作台"
                                               AutomationProperties.AutomationId="PageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               LineHeight="22"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="继续活动任务或开始新的批量生产" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,11,0,11"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="PrimaryPageAction"
                                        AutomationProperties.HelpText="阶段 0 只读投影，业务命令尚未接入">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Text="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="新建批次" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="进行中" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding ActiveTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AutomationProperties.AutomationId="ActiveTaskList" />
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="最近任务" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding RecentTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AlternationCount="3"
                                          AutomationProperties.AutomationId="RecentTaskList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,12" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                <Setter Property="FrameworkElement.Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="RecoveryFixturePanel">
                            <TextBlock Margin="0,0,0,8" Text="任务名称" />
                            <TextBox Width="360"
                                     Height="40"
                                     HorizontalAlignment="Left"
                                     Padding="10,7"
                                     InputMethod.IsInputMethodEnabled="True"
                                     AutomationProperties.AutomationId="ChineseImeFixtureInput" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="{Binding PageTitle}"
                                               AutomationProperties.AutomationId="PlaceholderPageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding PageSubtitle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding PrimaryActionText}"
                                        Visibility="{Binding HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                Padding="24"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding EmptyTitle}" />
                                <ItemsControl Margin="0,18,0,0"
                                              ItemsSource="{Binding PageRows}"
                                              AutomationProperties.AutomationId="SettingsSectionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="48"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                Height="64"
                Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="ActiveTaskBar">
            <Grid Margin="24,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="恢复验证任务" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="需要恢复 · 上次安全检查点" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="只读投影" />
            </Grid>
        </Border>
    </Grid>
</Window>
