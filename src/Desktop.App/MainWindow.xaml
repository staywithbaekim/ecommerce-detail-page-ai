                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                 PreviewMouseLeftButtonDown="CalibrationAssetList_MouseLeftButtonDown"
                                                 PreviewMouseMove="CalibrationAssetList_MouseMove"
                                                 AutomationProperties.AutomationId="CalibrationAssetList"
                                                 Visibility="{Binding IsManualCalibrationReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                     </StackPanel>
                                     </ScrollViewer>
                                     </Grid>
                                 </Border>
                             </Grid>
                             <Border Grid.Row="5"
                                     Margin="0,12,0,0"
                                     Padding="12,9"
                                     Background="{StaticResource SurfaceSubtleBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     CornerRadius="8"
                                     AutomationProperties.AutomationId="CalibrationStatusBar">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                     <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding CalibrationWorkflowStatusMessage}"
                                                TextTrimming="CharacterEllipsis" />
                                     <TextBlock Grid.Column="1"
                                                Margin="16,0,0,0"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding CalibrationFooterMetaText}"
                                                TextTrimming="CharacterEllipsis" />
                                 </Grid>
                             </Border>
                         </Grid>
                    </Grid>

                    <Grid Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="SettingsPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                           Text="设置"
                                           AutomationProperties.AutomationId="SettingsPageTitle" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="管理本机 AI 服务、隐私和运行环境" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <Border Padding="20" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="AI 服务" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource SmallBodyTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="固定使用已配置的 AI 服务；此处只管理本机凭据和上传授权。"
                                               TextWrapping="Wrap" />
                                    <Border Margin="0,18,0,0"
                                            Padding="14,12"
                                            Background="{StaticResource SurfaceSubtleBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            AutomationProperties.AutomationId="AiUploadConsentCard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     VerticalAlignment="Top"
                                                     Margin="0,6,0,0"
                                                     Fill="{StaticResource StatusCompletedBrush}" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                                           Text="上传授权"
                                                           AutomationProperties.AutomationId="AiUploadConsentTitle" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Style="{StaticResource SmallBodyTextStyle}"
                                                           Text="{Binding AiUploadConsentStatusText}"
                                                           AutomationProperties.AutomationId="AiUploadConsentStatus" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Style="{StaticResource CaptionTextStyle}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding AiUploadConsentDetailText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="重新读取"
                                                        Command="{Binding RefreshAiConsentCommand}"
                                                        AutomationProperties.AutomationId="RefreshAiConsentButton" />
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="允许上传压缩图"
                                                        Command="{Binding GrantAiUploadConsentCommand}"
                                                        IsEnabled="{Binding CanGrantAiUploadConsent}"
                                                        AutomationProperties.AutomationId="GrantAiUploadConsentButton" />
                                                <Button Style="{StaticResource DangerButtonStyle}"
                                                        Content="撤回授权"
                                                        Command="{Binding RevokeAiUploadConsentCommand}"
                                                        IsEnabled="{Binding CanRevokeAiUploadConsent}"
                                                        AutomationProperties.AutomationId="RevokeAiUploadConsentButton" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Margin="0,16,0,0" Padding="20" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="其他分区" />
                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding AdditionalSettingsRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="44"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1">
                                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="{Binding PageTitle}"
                                               AutomationProperties.AutomationId="PlaceholderPageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding PageSubtitle}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        IsHitTestVisible="False"
                                        Focusable="False"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{Binding PrimaryActionText}"
                                        Visibility="{Binding HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="2"
                                Padding="24"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="Bold"
                                           Text="{Binding EmptyTitle}" />
                                <ItemsControl Margin="0,18,0,0"
                                              ItemsSource="{Binding PageRows}"
                                              AutomationProperties.AutomationId="SettingsSectionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="48"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="40"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsSizeTableEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="SizeTableEditorDialog"
              AutomationProperties.Name="编辑尺码数据"
              AutomationProperties.LiveSetting="Assertive">
            <Border Width="1080"
                    Height="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="64" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="编辑尺码数据" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource CaptionTextStyle}" Text="只保留来源原文；/、\、- 都是合法内容，真正空单元格不能保存。" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="76"
                                Height="34"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="关闭"
                                Command="{Binding CloseSizeTableEditorCommand}"
                                AutomationProperties.AutomationId="CloseSizeTableEditorButton" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="256" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="14" Style="{StaticResource SectionCardStyle}" AutomationProperties.AutomationId="SizeTableSourcePanel">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="来源参考" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="只读，不修改市场尺码图" />
                                </StackPanel>
                                <Border Grid.Row="1" Background="{StaticResource SurfaceStrongBrush}" CornerRadius="5" ClipToBounds="True">
                                    <Grid>
                                        <Image Margin="8" Source="{Binding SizeTableEditor.SourcePreviewPath}" Stretch="Uniform" Visibility="{Binding SizeTableEditor.HasSourcePreview, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="只读市场尺码图" />
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="来源预览不可用；仍保留 hash 引用" Visibility="{Binding SizeTableEditor.HasNoSourcePreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding SizeTableEditor.SourceSummary}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding SizeTableEditor.RevisionText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Padding="14" Style="{StaticResource SectionCardStyle}" AutomationProperties.AutomationId="SizeTableStructuredGridPanel">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="结构化表格" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="选中表头或行后可删除；键盘可逐格输入中文。" />
                                </StackPanel>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding SizeTableEditor.Columns}"
                                         SelectedItem="{Binding SizeTableEditor.SelectedColumn, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         AutomationProperties.AutomationId="SizeTableHeaderList">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBox Width="116" Height="34" Margin="0,0,4,0" Padding="8,5" Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="尺码表表头" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding SizeTableEditor.Rows}"
                                         SelectedItem="{Binding SizeTableEditor.SelectedRow, Mode=TwoWay}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Visible"
                                         AutomationProperties.AutomationId="SizeTableRowList">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Cells}" AutomationProperties.Name="{Binding AccessibilityName}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Width="116" Height="34" Margin="0,2,4,2" Padding="8,5" Text="{Binding SourceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="尺码单元格" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="3" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="72" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Content="加一行" Command="{Binding AddSizeTableRowCommand}" AutomationProperties.AutomationId="AddSizeTableRowButton" />
                                        <Button Width="72" Style="{StaticResource SecondaryButtonStyle}" Content="删此行" Command="{Binding RemoveSizeTableRowCommand}" AutomationProperties.AutomationId="RemoveSizeTableRowButton" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Width="72" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Content="加一列" Command="{Binding AddSizeTableColumnCommand}" AutomationProperties.AutomationId="AddSizeTableColumnButton" />
                                        <Button Width="72" Style="{StaticResource SecondaryButtonStyle}" Content="删此列" Command="{Binding RemoveSizeTableColumnCommand}" AutomationProperties.AutomationId="RemoveSizeTableColumnButton" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" Padding="14" Style="{StaticResource SectionCardStyle}" AutomationProperties.AutomationId="SizeTableTemplatePreviewPanel">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="模板样式预览" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="结构预览；保存后确定性生成 PNG" />
                                </StackPanel>
                                <Border Grid.Row="1" Padding="12" Background="White" BorderBrush="#FF98A2B3" BorderThickness="1" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#FF101828" Text="尺码表" />
                                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding SizeTableEditor.Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><Border MinWidth="38" Padding="3" BorderBrush="#FF98A2B3" BorderThickness="0,0,1,1"><TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#FF101828" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" /></Border></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SmallBodyTextStyle}" Text="{Binding SizeTableEditor.StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button Grid.Column="1"
                                Width="172"
                                Height="38"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding SizeTableEditor.SaveButtonText}"
                                Command="{Binding SaveSizeTableCommand}"
                                AutomationProperties.AutomationId="SaveSizeTableButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="41"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsAiCandidatePreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="AiCandidatePreviewDialog"
              AutomationProperties.Name="查看候选图片">
            <Border Width="760"
                    MaxWidth="760"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="查看候选图片" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding AiCandidatePreview.UsageText}" />
                    </StackPanel>
                    <Border Grid.Row="2" MinHeight="280" MaxHeight="440" Background="{StaticResource SurfaceStrongBrush}" CornerRadius="8">
                        <Image Source="{Binding AiCandidatePreview.PreviewPath}" Stretch="Uniform" AutomationProperties.Name="候选商品图预览" />
                    </Border>
                    <StackPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="这个图片框需要" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding AiCandidatePreview.SelectionRequirement}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AiCandidatePreview.EvidenceText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AiCandidatePreview.AnalysisHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Content="关闭" Command="{Binding CloseAiCandidatePreviewCommand}" AutomationProperties.AutomationId="CloseAiCandidatePreviewButton" />
                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Content="检查商品范围" Command="{Binding AnalyzeAiPreviewAssetCommand}" AutomationProperties.AutomationId="AnalyzeAiPreviewAssetButton" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding AiCandidatePreview.ChooseText}" Command="{Binding ConfirmAiCandidateSelectionCommand}" AutomationProperties.AutomationId="ConfirmAiCandidateSelectionButton" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="40"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsAiUploadConsentDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="AiUploadConsentDialog"
              AutomationProperties.Name="AI 分析与图片上传授权"
              AutomationProperties.LiveSetting="Assertive">
            <Border Width="620"
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                               Text="AI 分析与图片上传授权"
                               AutomationProperties.AutomationId="AiUploadConsentDialogTitle" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="为了识别商品主体和匹配页面图片框，软件需要把必要的压缩分析副本上传到火山方舟。此授权只需确认一次，之后可在设置中查看或撤回。"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14,12"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SmallBodyTextStyle}"
                                       Text="只上传应用生成的必要压缩分析副本" />
                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource SmallBodyTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="不上传 PSD、原始高清图片、本地路径或正式输出；撤回后不再发起新的 AI 请求，已有本地结果不受影响。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <CheckBox Margin="0,18,0,0"
                              IsChecked="{Binding AiUploadConsentAcknowledged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Content="我已阅读并同意“AI 分析与图片上传授权”"
                              AutomationProperties.AutomationId="AiUploadConsentAcknowledgement" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="该选项默认不勾选。取消不会修改源文件，也不会开始扫描或上传。"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelAiUploadConsentCommand}"
                                Content="暂不使用 AI"
                                AutomationProperties.AutomationId="CancelAiUploadConsentButton" />
                        <Button IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConfirmAiUploadConsentCommand}"
                                IsEnabled="{Binding CanConfirmAiUploadConsent}"
                                Content="同意并继续"
                                AutomationProperties.AutomationId="ConfirmAiUploadConsentButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="30"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsBatchPageSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="BatchPageSelectionDialog"
              AutomationProperties.Name="选择本批次页面"
              AutomationProperties.LiveSetting="Assertive">
            <Border Width="560"
                    MaxHeight="640"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="选择本批次页面" />
                    <TextBlock Grid.Row="1"
                               Margin="0,6,0,0"
                               Style="{StaticResource SmallBodyTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="取消页面只影响当前批次，不会修改模板组。" />
                    <CheckBox Grid.Row="2"
                              Margin="0,18,0,8"
                              IsThreeState="True"
                              IsChecked="{Binding AreAllBatchPagesSelected, Mode=TwoWay}"
                              Content="全选本批次页面"
                              AutomationProperties.AutomationId="SelectAllBatchPagesCheckBox" />
                    <ListBox Grid.Row="3"
                             MaxHeight="400"
                             ItemsSource="{Binding BatchPages}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             AutomationProperties.AutomationId="BatchPageSelectionList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SurfaceListItemStyle}">
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="12,8"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Name}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Meta}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding BatchPageSelectionSummary}" />
                        <Button Grid.Column="1"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelBatchPageSelectionCommand}"
                                Content="取消"
                                AutomationProperties.AutomationId="CancelBatchPageSelectionButton" />
                        <Button Grid.Column="3"
                                IsDefault="True"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ApplyBatchPageSelectionCommand}"
                                Content="应用页面选择"
                                AutomationProperties.AutomationId="ApplyBatchPageSelectionButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="30"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsTemplateDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="TemplateDialog_PreviewKeyDown"
              AutomationProperties.AutomationId="TemplateConfirmationDialog"
              AutomationProperties.Name="{Binding TemplateDialogTitle}"
              AutomationProperties.LiveSetting="Assertive">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               LineHeight="24"
                               Text="{Binding TemplateDialogTitle}" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding TemplateDialogBody}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14,12"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Top"
                                     Margin="0,6,0,0"
                                     Fill="{StaticResource StatusAnalyzingBrush}" />
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource SmallBodyTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding TemplateDialogSafetyNote}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding TertiaryTemplateDialogCommand}"
                                Content="{Binding TemplateDialogTertiaryText}"
                                Visibility="{Binding TemplateDialogHasTertiaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="TemplateDialogTertiaryButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SecondaryTemplateDialogCommand}"
                                Content="{Binding TemplateDialogSecondaryText}"
                                Visibility="{Binding TemplateDialogHasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="TemplateDialogSecondaryButton" />
                        <Button IsDefault="True"
                                Command="{Binding ConfirmTemplateDialogCommand}"
                                Content="{Binding TemplateDialogPrimaryText}"
                                AutomationProperties.AutomationId="TemplateDialogPrimaryButton">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TemplateDialogIsDestructive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="0"
              Panel.ZIndex="20"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsDuplicateReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="DuplicatePsdReviewDialog"
              AutomationProperties.Name="重复 PSD 确认"
              AutomationProperties.LiveSetting="Assertive">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="检测到内容相同的 PSD" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="系统不会自动删除任何源文件。请选择这次导入应如何处理："
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="{Binding DuplicateExistingLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="复用模板库中已经验证的应用内部副本。" />
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="Medium"
                                       Text="{Binding DuplicateImportedLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="保留本次复制，作为独立页面继续检查。" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDuplicateCommand}"
                                Content="取消本次导入"
                                AutomationProperties.AutomationId="CancelDuplicateButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding KeepImportedDuplicateCommand}"
                                Content="保留本次导入"
                                AutomationProperties.AutomationId="KeepImportedDuplicateButton" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding KeepExistingDuplicateCommand}"
                                Content="复用已有副本"
                                AutomationProperties.AutomationId="ReuseExistingDuplicateButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Height="64"
                Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="ActiveTaskBar">
            <Grid Margin="24,0,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium" Text="恢复验证任务" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="需要恢复 · 上次安全检查点" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="只读投影" />
            </Grid>
        </Border>
    </Grid>
</Window>
