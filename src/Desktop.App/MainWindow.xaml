<Window x:Class="Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Desktop.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="电商详情页智能生产系统"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="DesktopMainWindow">
    <Window.Resources>
        <DataTemplate x:Key="TaskRowTemplate">
            <Border Height="68"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="Medium"
                                   LineHeight="18"
                                   Text="{Binding TaskName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="13"
                                   LineHeight="20"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding TemplateName}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusLight"
                                 Grid.Column="0"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource StatusAnalyzingBrush}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Grid.Column="6"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding UpdatedText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="8"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{Binding ActionText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusState}" Value="Completed">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Paused">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusPausedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusState}" Value="Recoverable">
                    <Setter TargetName="StatusLight" Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="TemplateLibraryCardTemplate">
            <Button Margin="0,0,0,12"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    FocusVisualStyle="{StaticResource VisibleFocusStyle}"
                    AutomationProperties.Name="{Binding Name}">
                <Border Height="76"
                        Padding="12"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52"
                                Height="52"
                                Background="{StaticResource SurfaceStrongBrush}"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="20"
                                       Text="&#xE8A5;" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource SmallBodyTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="{Binding Meta}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SmallBodyTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding UpdatedText}" />
                        <StackPanel Grid.Column="4"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource StatusDraftBrush}" />
                            <TextBlock Text="{Binding Status}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Text="查看" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ImportedPsdTemplate">
            <Border Height="68"
                    Margin="0,0,0,12"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8"
                             Height="8"
                             VerticalAlignment="Center"
                             Fill="{StaticResource StatusCompletedBrush}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                                   Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding InspectionSummary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Medium"
                               Text="{Binding Status}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TemplateDetailPageTemplate">
            <Border Height="68"
                    Padding="16"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding OrderText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="#237A45"
                               Text="{Binding Status}" />
                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Text="{Binding Action}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TemplatePageListItemTemplate">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                     <ColumnDefinition Width="34" />
                     <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="&#xE700;" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding DisplayOrder}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="Medium"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding Status}" />
                </StackPanel>
                 <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Width="26"
                            Height="22"
                            MinWidth="26"
                            Margin="0,0,0,2"
                            Padding="0"
                            Style="{StaticResource CompactButtonStyle}"
                            Tag="{Binding}"
                            Click="MoveTemplatePageUp_Click"
                            AutomationProperties.Name="上移页面">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70E;" />
                    </Button>
                    <Button Width="26"
                            Height="22"
                            MinWidth="26"
                            Padding="0"
                            Style="{StaticResource CompactButtonStyle}"
                            Tag="{Binding}"
                            Click="MoveTemplatePageDown_Click"
                            AutomationProperties.Name="下移页面">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70D;" />
                     </Button>
                 </StackPanel>
                 <Button Grid.Column="4"
                         Width="44"
                         Height="26"
                         Margin="8,0,0,0"
                         Padding="0"
                         VerticalAlignment="Center"
                         Style="{StaticResource CompactButtonStyle}"
                         Command="{Binding DataContext.RemoveTemplatePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         IsEnabled="{Binding CanRemove}"
                         Content="移除"
                         AutomationProperties.Name="移除模板页面" />
             </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}"
          AutomationProperties.AutomationId="DesktopShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="88" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Margin="16,20,16,16"
                                AutomationProperties.AutomationId="ApplicationBrand">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   Text="电商详情页" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="智能生产系统" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

                    <Border Grid.Row="2" Margin="8,16,8,16">
                        <ListBox x:Name="PrimaryNavigationList"
                                 ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Continue"
                                 AutomationProperties.AutomationId="PrimaryNavigation">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <DockPanel LastChildFill="False" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemChrome"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F5F5F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemChrome" Property="Background" Value="#F1F1F2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFooterNavigation}" Value="True">
                                            <Setter Property="DockPanel.Dock" Value="Bottom" />
                                            <Setter Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Glyph}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="PageScrollViewer">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTemplateCalibrationVisible}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <Grid Margin="32"
                      AutomationProperties.AutomationId="PageContent">
                    <Grid Visibility="{Binding IsWorkbenchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="264" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               LineHeight="32"
                                               Text="工作台"
                                               AutomationProperties.AutomationId="PageTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="14"
                                               LineHeight="22"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="继续活动任务或开始新的批量生产" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="0,11,0,11"
                                        Command="{Binding OpenBatchInputCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="PrimaryPageAction"
                                        AutomationProperties.Name="新建批次">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="16"
                                                   Text="&#xE710;" />
                                        <TextBlock VerticalAlignment="Center" Text="新建批次" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="进行中" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding ActiveTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AutomationProperties.AutomationId="ActiveTaskList" />
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Height="24"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       LineHeight="24"
                                       Text="最近任务" />
                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding RecentTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}"
                                          AlternationCount="3"
                                          AutomationProperties.AutomationId="RecentTaskList">
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="FrameworkElement.Margin" Value="0,0,0,12" />
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="2">
                                                <Setter Property="FrameworkElement.Margin" Value="0" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Margin="0,24,0,0"
                                    Visibility="{Binding IsFixtureVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="RecoveryFixturePanel">
                            <TextBlock Margin="0,0,0,8" Text="任务名称" />
                            <TextBox Width="360"
                                     Height="40"
                                     HorizontalAlignment="Left"
                                     Padding="10,7"
                                     InputMethod.IsInputMethodEnabled="True"
                                     AutomationProperties.AutomationId="ChineseImeFixtureInput" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding IsBatchInputVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="BatchInputPage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="64" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" MinHeight="68">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="新建批次 / 扫描前设置" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource PageTitleTextStyle}"
                                           Text="新建批次"
                                           AutomationProperties.AutomationId="BatchInputTitle" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource SmallBodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="确认模板、商品目录、输出位置和本批次页面" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="16,6,0,0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <TextBlock Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="&#xE823;" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding BatchDraftSaveText}"
                                           AutomationProperties.AutomationId="BatchDraftSaveStatus" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" AutomationProperties.AutomationId="BatchInputForm">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="模板与目录" />
                                <TextBlock Margin="0,4,0,12"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="选择已校准模板，并确认本批次的输入与正式输出位置" />

                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="模板组" />
                                <ComboBox Margin="0,6,0,0"
                                          ItemsSource="{Binding TemplateGroups}"
                                          SelectedItem="{Binding SelectedBatchTemplate, Mode=TwoWay}"
                                          IsEnabled="{Binding IsBatchConfigurationEditable}"
                                          Style="{StaticResource FieldComboBoxStyle}"
                                          AutomationProperties.AutomationId="BatchTemplateSelect"
                                          AutomationProperties.Name="模板组">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,6,0,0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{Binding BatchTemplateHelperText}" />

                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CreateTemplateFromBatchCommand}"
                                            Content="新建模板组"
                                            AutomationProperties.AutomationId="CreateTemplateFromBatchButton" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding ImportTemplateFromBatchCommand}"
                                            Content="导入已校准模板"
                                            AutomationProperties.AutomationId="ImportTemplateFromBatchButton" />
                                </StackPanel>

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Text="商品目录" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             IsReadOnly="True"
                                             Text="{Binding BatchInputDirectoryDisplay, Mode=OneWay}"
                                             AutomationProperties.AutomationId="BatchInputDirectoryField"
                                             AutomationProperties.Name="商品目录" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseBatchInputDirectoryCommand}"
                                            Content="选择目录"
                                            AutomationProperties.AutomationId="ChooseBatchInputDirectoryButton" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusDraftBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="{Binding BatchRecognitionText}"
                                               AutomationProperties.AutomationId="BatchRecognitionStatus"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Grid>

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Text="正式输出目录" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             IsReadOnly="True"
                                             Text="{Binding BatchOutputDirectoryDisplay, Mode=OneWay}"
                                             AutomationProperties.AutomationId="BatchOutputDirectoryField"
                                             AutomationProperties.Name="正式输出目录" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ChooseBatchOutputDirectoryCommand}"
                                            Content="选择目录"
                                            AutomationProperties.AutomationId="ChooseBatchOutputDirectoryButton" />
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusDraftBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource CaptionTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="{Binding BatchOutputConfirmationText}"
                                               AutomationProperties.AutomationId="BatchOutputConfirmationStatus" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="生成设置" />
                                <TextBlock Margin="0,4,0,12"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="设置本批次的选图方式、页面范围与输出格式" />

                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="选图方式" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0"
                                                 GroupName="BatchSelectionMode"
                                                 Style="{StaticResource FieldRadioCardStyle}"
                                                 IsEnabled="{Binding IsBatchConfigurationEditable}"
                                                 IsChecked="{Binding IsBatchAutomaticSelection, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="BatchAutomaticSelectionOption"
                                                 AutomationProperties.Name="AI 自动选图">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="AI 自动选图" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="自动分析并匹配每个图片框" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="2"
                                                 GroupName="BatchSelectionMode"
                                                 Style="{StaticResource FieldRadioCardStyle}"
                                                 IsEnabled="{Binding IsBatchConfigurationEditable}"
                                                 IsChecked="{Binding IsBatchManualSelection, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="BatchManualSelectionOption"
                                                 AutomationProperties.Name="人工选图">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="人工选图" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="由用户选图，后续仍可智能适配" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <Border Margin="0,14,0,0" Style="{StaticResource SectionCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                                       Text="{Binding BatchPageSelectionSummary}"
                                                       AutomationProperties.AutomationId="BatchPageSelectionSummary" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="取消页面只影响当前批次" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenBatchPageSelectionCommand}"
                                                Content="选择页面"
                                                AutomationProperties.AutomationId="OpenBatchPageSelectionButton" />
                                    </Grid>
                                </Border>

                                <Border Margin="0,12,0,0" Style="{StaticResource SectionCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="同时输出可编辑 PSD" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="默认关闭；开启后不适用 5 分钟性能目标" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  IsEnabled="{Binding IsBatchConfigurationEditable}"
                                                  IsChecked="{Binding BatchIncludeEditablePsd, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="BatchEditablePsdToggle"
                                                  AutomationProperties.Name="同时输出可编辑 PSD" />
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,14,0,8"
                                           Style="{StaticResource FieldLabelTextStyle}"
                                           Text="输出结构预览" />
                                <Border Padding="16,12"
                                        Background="{StaticResource SurfaceSubtleBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="款式目录\" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="01-页面名称.jpg" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="02-页面名称.jpg" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="每款独立目录 · JPG 始终生成" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="4"
                                Margin="0,12,0,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                AutomationProperties.AutomationId="BatchInputFooter">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusDraftBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BatchStatusState}" Value="Scanning">
                                                    <Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BatchStatusState}" Value="ScanReady">
                                                    <Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BatchStatusState}" Value="ScanBlocked">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SmallBodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding BatchStatusMessage}"
                                           AutomationProperties.AutomationId="BatchInputStatus"
                                           AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding CancelBatchInputCommand}"
                                        Content="取消"
                                        AutomationProperties.AutomationId="CancelBatchInputButton" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RetryBatchScanCommand}"
                                        Content="重试扫描"
                                        Visibility="{Binding HasBatchRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="RetryBatchScanButton" />
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding CancelBatchScanCommand}"
                                        Content="取消扫描"
                                        Visibility="{Binding IsBatchScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="CancelBatchScanButton" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ScanBatchInputCommand}"
                                        Content="{Binding BatchPrimaryActionText}"
                                        AutomationProperties.AutomationId="ScanBatchInputButton"
                                        AutomationProperties.Name="{Binding BatchPrimaryActionText}" />
                            </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding IsTemplateSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="TemplateWorkspace">
                        <!-- T-01: template library and detail use real application projections. -->
                        <Grid Visibility="{Binding IsTemplateLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateLibraryPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                               Text="模板库"
                                               AutomationProperties.AutomationId="TemplateLibraryTitle" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="查找、维护和迁移已校准模板组" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,11,8,11"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ImportTemplatePackageCommand}"
                                            Content="导入已校准模板"
                                            AutomationProperties.AutomationId="ImportTemplatePackageButton" />
                                    <Button Margin="0,11,0,11"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding NewTemplateCommand}"
                                            AutomationProperties.AutomationId="NewTemplateGroupButton"
                                            AutomationProperties.Name="新建模板组">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="16"
                                                       Text="&#xE710;" />
                                            <TextBlock Text="新建模板组" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <StackPanel Visibility="{Binding HasTemplateGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="{Binding TemplateGroups.Count, StringFormat={}{0} 个模板组}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="按最近更新排序" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TemplateGroups}"
                                                  ItemTemplate="{StaticResource TemplateLibraryCardTemplate}"
                                                  AutomationProperties.AutomationId="TemplateGroupList" />
                                </StackPanel>

                                <Border Padding="48,64"
                                        Style="{StaticResource SectionCardStyle}"
                                        Visibility="{Binding IsTemplateLibraryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="TemplateLibraryEmptyState">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48"
                                                Height="48"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource SurfaceStrongBrush}"
                                                CornerRadius="24">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="22"
                                                       Text="&#xE8A5;" />
                                        </Border>
                                        <TextBlock Margin="0,18,0,0"
                                                   HorizontalAlignment="Center"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="尚无模板组" />
                                        <TextBlock Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="从一个或多个 PSD 开始建立可重复使用的模板页面。" />
                                        <Button Margin="0,22,0,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding NewTemplateCommand}"
                                                Content="新建模板组"
                                                AutomationProperties.AutomationId="EmptyNewTemplateGroupButton" />
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateDetailsPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                             <Grid>
                                 <Grid.ColumnDefinitions>
                                     <ColumnDefinition Width="*" />
                                     <ColumnDefinition Width="Auto" />
                                 </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Button Width="84"
                                            Height="28"
                                            Margin="0,0,0,10"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding BackToTemplateLibraryCommand}"
                                            Content="← 返回"
                                            AutomationProperties.AutomationId="BackToTemplateLibraryButton" />
                                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                               Text="{Binding TemplateDetailsTitle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource SmallBodyTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateDetailsMeta}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Orientation="Horizontal">
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource SecondaryButtonStyle}"
                                             Foreground="{StaticResource DangerBrush}"
                                             Content="删除"
                                            Command="{Binding DeleteTemplateCommand}"
                                            AutomationProperties.AutomationId="DeleteTemplateGroupButton" />
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="另存为"
                                            Command="{Binding SaveTemplateAsCommand}"
                                            AutomationProperties.AutomationId="SaveTemplateAsButton" />
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="导出"
                                            Command="{Binding ExportTemplateCommand}"
                                            AutomationProperties.AutomationId="ExportTemplatePackageButton" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding AddTemplatePagesCommand}"
                                            IsEnabled="{Binding CanIncrementTemplate}"
                                            Content="添加模板页面"
                                            AutomationProperties.AutomationId="AddTemplatePagesButton" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                                   Text="模板页面" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="页面顺序决定详情页输出顺序" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding TemplateDetailPages}"
                                                  ItemTemplate="{StaticResource TemplateDetailPageTemplate}"
                                                  AutomationProperties.AutomationId="TemplateDetailPageList" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- T-02: source selection stays read-only; only application-owned copies are passed to the workspace service. -->
                        <Grid Visibility="{Binding IsTemplateImportVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplatePsdImportPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="64" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Button Height="22"
                                        MinWidth="0"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding BackToTemplateLibraryCommand}"
                                        Content="模板组 / 返回模板库"
                                        AutomationProperties.AutomationId="CancelTemplateImportButton" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PageTitleTextStyle}"
                                           Text="{Binding TemplateFlowTitle}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="导入一个或多个 PSD，并确认首次校准方式" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="1  导入模板" />
                                <Border Width="40" Height="1" Margin="12,9" Background="{StaticResource BorderBrush}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="2  页面设置" />
                                <Border Width="40" Height="1" Margin="12,9" Background="{StaticResource BorderBrush}" />
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="3  校准" />
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="0"
                                        Background="{StaticResource SurfaceBrush}"
                                        AllowDrop="True"
                                        DragOver="PsdDropZone_DragOver"
                                        Drop="PsdDropZone_Drop"
                                        AutomationProperties.AutomationId="TemplatePsdDropZone"
                                        AutomationProperties.Name="PSD 文件拖放区域">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="模板文件" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="软件只复制 PSD 副本到模板库，不修改用户选择的源文件。" />
                                        <Border Margin="0,12,0,0"
                                                Padding="12"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="模板组名称" />
                                                <TextBox Margin="0,4,0,0"
                                                         Style="{StaticResource FieldTextBoxStyle}"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Text="{Binding TemplateGroupName, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsIncrementalTemplateDraft}"
                                                         InputMethod.IsInputMethodEnabled="True"
                                                         AutomationProperties.AutomationId="TemplateGroupNameInput"
                                                         AutomationProperties.Name="模板组名称" />
                                            </StackPanel>
                                        </Border>
                                        <Button Width="120"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ChoosePsdFiles_Click"
                                                Content="选择 PSD"
                                                AutomationProperties.AutomationId="ChoosePsdFilesButton" />
                                        <ItemsControl Margin="0,12,0,0"
                                                      ItemsSource="{Binding ImportedTemplateFiles}"
                                                      ItemTemplate="{StaticResource ImportedPsdTemplate}"
                                                      AutomationProperties.AutomationId="ImportedPsdList" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Text="也可以把 PSD 直接拖到此区域；源文件始终只读。" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Padding="0" Background="{StaticResource SurfaceBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="校准方式" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="两种方式最终都进入同一个校准编辑器复核。" />
                                        <Border Height="68"
                                                Margin="0,12,0,0"
                                                Padding="14,12"
                                                Background="{StaticResource SurfaceStrongBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="18" Height="18" Stroke="{StaticResource TextBrush}" StrokeThickness="1">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Offset="0" Color="#171717" />
                                                            <GradientStop Offset="0.42" Color="#171717" />
                                                            <GradientStop Offset="0.45" Color="#FFFFFF" />
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="拖拽校准" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="在模板画布逐框放入正确素材，并由人工确认" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Height="68"
                                                Margin="0,12,0,0"
                                                Padding="14,12"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Opacity="0.55">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="18" Height="18" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="从人工结果学习（尚未启用）" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="真实 AI 学习完成验收后才会开放" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="6" Background="{StaticResource SurfaceBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource SmallBodyTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding TemplateStatusMessage}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Margin="0,0,12,0"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding BackToTemplateLibraryCommand}"
                                            Content="取消" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ContinuePageSettingsCommand}"
                                            IsEnabled="{Binding CanContinuePageSettings}"
                                            Content="继续页面设置"
                                            AutomationProperties.AutomationId="ContinuePageSettingsButton" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- T-03: page settings, order and incremental read-only scope. -->
                        <Grid Visibility="{Binding IsTemplatePageSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplatePageSettingsPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Height="96">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="56" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="页面设置" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource SmallBodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding TemplateSettingsSubtitle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Ellipse Width="8" Height="8" Margin="0,7,8,0" VerticalAlignment="Top" Fill="{StaticResource StatusCompletedBrush}" />
                                        <TextBlock VerticalAlignment="Top"
                                                   Style="{StaticResource SmallBodyTextStyle}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="草稿已自动保存" />
                                        <Button Height="28"
                                                Margin="18,0,0,0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding AbandonTemplateDraftCommand}"
                                                Content="放弃模板组"
                                                AutomationProperties.AutomationId="AbandonTemplateDraftButton" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SurfaceStrongBrush}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="1" />
                                        </Border>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="导入模板" />
                                        <Border Width="40" Height="1" Margin="10,0" Background="{StaticResource BorderBrush}" />
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="White" Text="2" />
                                        </Border>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Text="页面设置" />
                                        <Border Width="40" Height="1" Margin="10,0" Background="{StaticResource BorderBrush}" />
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SurfaceStrongBrush}">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="3" />
                                        </Border>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelTextStyle}" Foreground="{StaticResource TextMutedBrush}" Text="校准" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateSettingsScope}" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding TemplatePageSettingsPageColumnWidth}" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="{Binding TemplatePageSettingsInspectorColumnWidth}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Padding="0"
                                        Style="{StaticResource SectionCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="64" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="16,10,16,8">
                                            <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="模板页面" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="拖放或按钮调整输出顺序" />
                                        </StackPanel>
                                         <ListBox Grid.Row="1"
                                                  ItemsSource="{Binding TemplatePages}"
                                                  SelectedItem="{Binding SelectedTemplatePage, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource TemplatePageListItemTemplate}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  AllowDrop="True"
                                                 PreviewMouseLeftButtonDown="TemplatePageList_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="TemplatePageList_PreviewMouseMove"
                                                 DragOver="TemplatePageList_DragOver"
                                                 Drop="TemplatePageList_Drop"
                                                 KeyDown="TemplatePageList_KeyDown"
                                                 AutomationProperties.AutomationId="TemplatePageOrderList">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="MinHeight" Value="56" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Margin" Value="14,3" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource SurfaceStrongBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Button Grid.Row="2"
                                                Margin="12"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ReturnToTemplateImportCommand}"
                                                Content="继续添加 PSD"
                                                AutomationProperties.AutomationId="ReturnToPsdImportButton" />
                                    </Grid>
                                 </Border>

                                <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                                           Text="页面预览" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding SelectedTemplatePage.Name}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Text="{Binding SelectedTemplatePage.CanvasSummary}" />
                                        </Grid>
                                        <Border Height="494"
                                                Background="{StaticResource CanvasStageBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding SelectedTemplatePage.PreviewSourceReference}"
                                                       Stretch="Uniform"
                                                       AutomationProperties.AutomationId="TemplatePageSettingsPreviewImage" />
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTemplatePage.PreviewSourceReference}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               FontFamily="Segoe Fluent Icons"
                                                               FontSize="24"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="&#xE8B7;" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Text="暂无预览" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="0,12,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   Text="预览来自应用副本；源 PSD 保持只读。"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}">
                                    <ContentControl Content="{Binding SelectedTemplatePage}">
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate DataType="{x:Type local:TemplatePageRowViewModel}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,18">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                    <TextBlock Style="{StaticResource PanelTitleTextStyle}"
                                                               Text="页面属性" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Text="{Binding CanvasSummary}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Padding="9,4"
                                                                Background="{StaticResource SurfaceStrongBrush}"
                                                                CornerRadius="12">
                                                            <TextBlock FontSize="12" Text="{Binding Status}" />
                                                        </Border>
                                                    </Grid>

                                                    <TextBlock Margin="0,0,0,6"
                                                               Style="{StaticResource FieldLabelTextStyle}"
                                                               Text="页面名称" />
                                                    <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsReadOnly}"
                                                             InputMethod.IsInputMethodEnabled="True"
                                                             AutomationProperties.AutomationId="TemplatePageNameInput"
                                                             AutomationProperties.Name="页面名称" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="用于输出命名，页码随排序更新" />

                                                    <TextBlock Margin="0,10,0,6"
                                                               Style="{StaticResource FieldLabelTextStyle}"
                                                               Text="内容类型" />
                                                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                                              ItemsSource="{x:Static local:TemplatePageRowViewModel.ContentTypeOptions}"
                                                              SelectedItem="{Binding ContentTypeText, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsAffected}"
                                                              AutomationProperties.AutomationId="TemplatePageContentTypeSelect" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="也可设为动态尺码表页" />

                                                    <TextBlock Margin="0,10,0,6"
                                                               Style="{StaticResource FieldLabelTextStyle}"
                                                               Text="生成方式" />
                                                    <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                                              ItemsSource="{x:Static local:TemplatePageRowViewModel.GenerationModeOptions}"
                                                              SelectedItem="{Binding GenerationModeText, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsAffected}"
                                                              AutomationProperties.AutomationId="TemplatePageGenerationModeSelect" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"
                                                               Text="只有每款生成一次或按变体数量组合" />

                                                    <StackPanel Margin="0,18,0,0"
                                                                Visibility="{Binding IsVariantCapacityVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Margin="0,0,0,7"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Text="组合容量" />
                                                        <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                                 Text="{Binding VariantCapacity, UpdateSourceTrigger=LostFocus}"
                                                                 IsReadOnly="{Binding IsReadOnly}"
                                                                 AutomationProperties.AutomationId="TemplatePageVariantCapacityInput" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="必须填写大于 0 的数字" />
                                                    </StackPanel>

                                                    <Border Height="50"
                                                            Margin="0,10,0,0"
                                                            Padding="12,6"
                                                            Background="{StaticResource SurfaceSubtleBrush}"
                                                            CornerRadius="6">
                                                        <Grid>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="在模板组中启用" />
                                                                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="可在新建批次中选择" />
                                                            </StackPanel>
                                                            <CheckBox HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center"
                                                                      Style="{StaticResource ToggleSwitchStyle}"
                                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      IsEnabled="{Binding IsAffected}"
                                                                      AutomationProperties.AutomationId="TemplatePageEnabledCheckBox" />
                                                        </Grid>
                                                    </Border>

                                                    <Border Margin="0,10,0,0"
                                                            Padding="12"
                                                            Background="{StaticResource InfoSurfaceBrush}"
                                                            CornerRadius="6">
                                                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                                   Text="{Binding RuleSummary}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding TemplateStatusMessage}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ReturnToTemplateImportCommand}"
                                            Content="上一步" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding StartCalibrationCommand}"
                                            Content="开始校准"
                                            AutomationProperties.AutomationId="StartCalibrationButton" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateCalibrationPendingVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateCalibrationPendingPage">
                            <Border Padding="48,64" Style="{StaticResource SectionCardStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="48"
                                            Height="48"
                                            Background="{StaticResource InfoSurfaceBrush}"
                                            CornerRadius="24">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="22"
                                                   Text="&#xE9D2;" />
                                    </Border>
                                    <TextBlock Margin="0,18,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Text="页面设置已保存" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding TemplateStatusMessage}"
                                               TextAlignment="Center" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="暂时无法打开校准编辑器；请返回页面设置，检查当前页结构或素材后重试。" />
                                    <Button Margin="0,22,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ReturnToPageSettingsCommand}"
                                            Content="返回页面设置" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Visibility="{Binding IsTemplateCalibrationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="TemplateCalibrationPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                               Text="{Binding CalibrationHeaderTitle}" />
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="导入模板  /  页面设置  /  校准" />
                                 </StackPanel>
                                 <StackPanel Grid.Column="1" Orientation="Horizontal">
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource GhostButtonStyle}"
                                             Command="{Binding ExitCalibrationCommand}"
                                             Content="返回页面设置"
                                             AutomationProperties.AutomationId="ExitCalibrationButton" />
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource GhostButtonStyle}"
                                             Command="{Binding ReturnToTemplateImportCommand}"
                                             Content="继续添加 PSD"
                                             AutomationProperties.AutomationId="AddPsdFromCalibrationButton" />
                                     <Button Margin="0,0,8,0"
                                             Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding UndoCalibrationCommand}"
                                            IsEnabled="{Binding CalibrationDraft.CanUndo}"
                                            Content="撤销"
                                            AutomationProperties.AutomationId="UndoCalibrationButton" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding RedoCalibrationCommand}"
                                            IsEnabled="{Binding CalibrationDraft.CanRedo}"
                                            Content="重做"
                                            AutomationProperties.AutomationId="RedoCalibrationButton" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SaveTemplateCommand}"
                                            Content="保存模板组"
                                            AutomationProperties.AutomationId="SaveTemplateGroupButton" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsCalibrationNarrowLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
