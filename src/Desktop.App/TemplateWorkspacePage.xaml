<UserControl x:Class="Desktop.App.TemplateWorkspacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Desktop.App"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <DataTemplate x:Key="TemplateLibraryCardTemplate">
            <Grid Height="76" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>
                <Button Grid.ColumnSpan="5"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding DataContext.OpenTemplateCommand, RelativeSource={RelativeSource AncestorType=local:TemplateWorkspacePage}}"
                        CommandParameter="{Binding}"
                        FocusVisualStyle="{StaticResource VisibleFocusStyle}"
                        AutomationProperties.AutomationId="OpenTemplateGroupRowButton"
                        AutomationProperties.Name="{Binding Name, StringFormat=打开模板组 {0}}">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            AutomationProperties.AutomationId="TemplateGroupRowChrome" />
                </Button>
                <Border Grid.Column="0"
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Background="{StaticResource SurfaceStrongBrush}"
                        CornerRadius="6">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="20"
                               Text="&#xE8A5;" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource FieldLabelTextStyle}"
                               Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource SmallBodyTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding Meta}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Style="{StaticResource SmallBodyTextStyle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding UpdatedText}" />
                <StackPanel Grid.Column="3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0"
                             Fill="{StaticResource StatusDraftBrush}" />
                    <TextBlock Text="{Binding Status}" />
                </StackPanel>
                <StackPanel Grid.Column="4"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="68"
                            Margin="0,0,4,0"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding DataContext.RenameTemplateCommand, RelativeSource={RelativeSource AncestorType=local:TemplateWorkspacePage}}"
                            CommandParameter="{Binding}"
                            Content="重命名"
                            AutomationProperties.AutomationId="RenameTemplateGroupButton"
                            AutomationProperties.Name="{Binding Name, StringFormat=重命名模板组 {0}}" />
                    <Button Width="56"
                            Style="{StaticResource GhostButtonStyle}"
                            Foreground="{StaticResource DangerBrush}"
                            Command="{Binding DataContext.DeleteTemplateFromLibraryCommand, RelativeSource={RelativeSource AncestorType=local:TemplateWorkspacePage}}"
                            CommandParameter="{Binding}"
                            Content="删除"
                            AutomationProperties.AutomationId="DeleteTemplateGroupFromLibraryButton"
                            AutomationProperties.Name="{Binding Name, StringFormat=删除模板组 {0}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TemplateDetailPageTemplate">
            <Border Height="68"
                    Padding="16"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding OrderText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="{Binding Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding Meta}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource StatusCompletedTextBrush}"
                               Text="{Binding Status}" />
                    <Button Grid.Column="3"
                            Width="56"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource CompactButtonStyle}"
                            Command="{Binding DataContext.EditTemplatePageCommand, RelativeSource={RelativeSource AncestorType=local:TemplateWorkspacePage}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Action}"
                            ToolTip="创建该页面的编辑草稿；其他页面保持只读"
                            AutomationProperties.AutomationId="EditTemplatePageButton"
                            AutomationProperties.Name="编辑页面" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid PreviewKeyDown="TemplateWorkspacePage_PreviewKeyDown">
        <Grid Visibility="{Binding IsTemplateSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              AutomationProperties.AutomationId="TemplateWorkspace">
            <!-- T-01: template library and detail use real application projections. -->
            <Grid Visibility="{Binding IsTemplateLibraryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutomationProperties.AutomationId="TemplateLibraryPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                   Text="模板库"
                                   AutomationProperties.AutomationId="TemplateLibraryTitle" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="查找、维护和迁移已校准模板组" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,11,8,11"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ImportTemplatePackageCommand}"
                                Content="导入已校准模板"
                                AutomationProperties.AutomationId="ImportTemplatePackageButton" />
                        <Button Margin="0,11,0,11"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NewTemplateCommand}"
                                AutomationProperties.AutomationId="NewTemplateGroupButton"
                                AutomationProperties.Name="新建模板组">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Text="&#xE710;" />
                                <TextBlock Text="新建模板组" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
        
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,12"
                               Style="{StaticResource SmallBodyTextStyle}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding TemplateStatusMessage}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasTemplateStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                               AutomationProperties.AutomationId="TemplateLibraryStatus" />
                    <StackPanel Grid.Row="1"
                                Visibility="{Binding HasTemplateGroups, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="{Binding TemplateGroups.Count, StringFormat={}{0} 个模板组}" />
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="按最近更新排序" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TemplateGroups}"
                                           ItemTemplate="{StaticResource TemplateLibraryCardTemplate}"
                                      AutomationProperties.AutomationId="TemplateGroupList" />
                    </StackPanel>
        
                    <Border Grid.Row="1"
                            Padding="48,64"
                            Style="{StaticResource SectionCardStyle}"
                            Visibility="{Binding IsTemplateLibraryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="TemplateLibraryEmptyState">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="48"
                                    Height="48"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource SurfaceStrongBrush}"
                                    CornerRadius="24">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="22"
                                           Text="&#xE8A5;" />
                            </Border>
                            <TextBlock Margin="0,18,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="尚无模板组" />
                            <TextBlock Margin="0,8,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="从一个或多个 PSD 开始建立可重复使用的模板页面。" />
                            <Button Margin="0,22,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding NewTemplateCommand}"
                                    Content="新建模板组"
                                    AutomationProperties.AutomationId="EmptyNewTemplateGroupButton" />
                         </StackPanel>
                     </Border>
                </Grid>
            </Grid>
        
            <Grid Visibility="{Binding IsTemplateDetailsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutomationProperties.AutomationId="TemplateDetailsPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                 <Grid>
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" />
                     </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Button Width="84"
                                Height="28"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding BackToTemplateLibraryCommand}"
                                Content="← 返回"
                                AutomationProperties.AutomationId="BackToTemplateLibraryButton" />
                        <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                   Text="{Binding TemplateDetailsTitle}" />
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource SmallBodyTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding TemplateDetailsMeta}" />
                         <TextBlock Margin="0,5,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding TemplateStatusMessage}"
                                    TextWrapping="Wrap"
                                    AutomationProperties.AutomationId="TemplateDetailsStatus" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding EditTemplateGroupCommand}"
                                Content="编辑模板组"
                                AutomationProperties.AutomationId="EditTemplateGroupButton" />
                         <Button Margin="0,0,8,0"
                                 Style="{StaticResource SecondaryButtonStyle}"
                                 Foreground="{StaticResource DangerBrush}"
                                 Content="删除"
                                Command="{Binding DeleteTemplateCommand}"
                                AutomationProperties.AutomationId="DeleteTemplateGroupButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="另存为"
                                Command="{Binding SaveTemplateAsCommand}"
                                AutomationProperties.AutomationId="SaveTemplateAsButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="导出"
                                Command="{Binding ExportTemplateCommand}"
                                AutomationProperties.AutomationId="ExportTemplatePackageButton" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddTemplatePagesCommand}"
                                IsEnabled="{Binding CanIncrementTemplate}"
                                Content="添加模板页面"
                                AutomationProperties.AutomationId="AddTemplatePagesButton" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                                       Text="模板页面" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="页面顺序决定详情页输出顺序" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TemplateDetailPages}"
                                           ItemTemplate="{StaticResource TemplateDetailPageTemplate}"
                                      AutomationProperties.AutomationId="TemplateDetailPageList" />
                    </StackPanel>
                </Border>
            </Grid>
        
            <Grid Visibility="{Binding IsTemplateCanvasVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                  AutomationProperties.AutomationId="TemplateCanvasPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="330" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                         <StackPanel>
                             <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                        Text="{Binding TemplateCanvasTitle}" />
                             <TextBlock Margin="0,4,0,0"
                                        Style="{StaticResource SmallBodyTextStyle}"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="{Binding TemplateCanvasSubtitle}" />
                         </StackPanel>
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="{Binding CalibrationFlowStepText}" />
                     </StackPanel>
                     <StackPanel Grid.Column="1" Orientation="Horizontal">
                         <Button Margin="0,0,8,0"
                                 Style="{StaticResource GhostButtonStyle}"
                                  Command="{Binding BackToTemplateLibraryCommand}"
                                  Content="返回模板库"
                                  AutomationProperties.AutomationId="BackToTemplateLibraryFromCanvasButton" />
                          <Button Margin="0,0,8,0"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Click="ChoosePsdFiles_Click"
                                  Content="添加 PSD"
                                  AutomationProperties.AutomationId="AddPsdToCanvasButton" />
                          <Button Margin="0,0,8,0"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Click="ChoosePsdFolder_Click"
                                  Content="导入文件夹"
                                  AutomationProperties.AutomationId="AddPsdFolderToCanvasButton" />
                         <Button Margin="0,0,8,0"
                                 Style="{StaticResource SecondaryButtonStyle}"
                                 Command="{Binding SaveTemplateAsCommand}"
                                 IsEnabled="{Binding CanSaveAsTemplate}"
                                 Content="另存为"
                                 AutomationProperties.AutomationId="SaveAsTemplateFromCalibrationButton" />
                         <Button Margin="0,0,8,0"
                                 Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding UndoCalibrationCommand}"
                                IsEnabled="{Binding CalibrationDraft.CanUndo}"
                                Content="撤销"
                                AutomationProperties.AutomationId="UndoCalibrationButton"
                                Visibility="{Binding IsManualCalibrationReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RedoCalibrationCommand}"
                                IsEnabled="{Binding CalibrationDraft.CanRedo}"
                                Content="重做"
                                AutomationProperties.AutomationId="RedoCalibrationButton"
                                Visibility="{Binding IsManualCalibrationReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ReanalyzeReferenceLearningCommand}"
                                Content="重新分析当前页"
                                Visibility="{Binding IsReferenceLearningReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="ReanalyzeReferenceLearningButton" />
                         <Button Margin="8,0,0,0"
                                 Style="{StaticResource GhostButtonStyle}"
                                 Command="{Binding CancelReferenceLearningCommand}"
                                 Content="取消本次学习"
                                 Visibility="{Binding IsReferenceLearningReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 AutomationProperties.AutomationId="CancelReferenceLearningButton" />
                         <Button Margin="8,0,0,0"
                                 Style="{StaticResource PrimaryButtonStyle}"
                                 Command="{Binding SaveTemplateCommand}"
                                 IsEnabled="{Binding CanSaveTemplateCanvas}"
                                 Content="保存模板组"
                                AutomationProperties.AutomationId="SaveTemplateGroupButton" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            Visibility="{Binding IsCalibrationNarrowLayout, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="CalibrationNarrowPanelSwitcher">
                    <Button Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ShowCalibrationPagesCommand}"
                            Content="页面"
                            AutomationProperties.AutomationId="ShowCalibrationPagesButton" />
                    <Button Width="120"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ShowCalibrationCanvasCommand}"
                            Content="画布"
                            AutomationProperties.AutomationId="ShowCalibrationCanvasButton" />
                    <Button Width="140"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ShowCalibrationInspectorCommand}"
                            Content="素材与规则"
                            AutomationProperties.AutomationId="ShowCalibrationInspectorButton" />
                </StackPanel>
                <Border Grid.Row="4"
                        Style="{StaticResource SectionCardStyle}"
                        Padding="0"
                        AutomationProperties.AutomationId="TemplateInfiniteCanvas">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="Medium" Text="模板无限画布" />
                                <TextBlock Margin="12,0,0,0" Foreground="{StaticResource TextMutedBrush}" Text="页面位置只影响编辑布局；输出顺序仍按页面顺序" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,6,0" Style="{StaticResource CompactButtonStyle}" Content="−" Click="TemplateBoardZoomOut_Click" AutomationProperties.AutomationId="TemplateBoardZoomOutButton" />
                                <TextBlock Width="62" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="{Binding TemplateBoardZoomText}" />
                                <Button Margin="6,0,6,0" Style="{StaticResource CompactButtonStyle}" Content="＋" Click="TemplateBoardZoomIn_Click" AutomationProperties.AutomationId="TemplateBoardZoomInButton" />
                                <Button Style="{StaticResource CompactButtonStyle}" Content="重置视图" Click="TemplateBoardReset_Click" AutomationProperties.AutomationId="TemplateBoardResetButton" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource CanvasStageBrush}" ClipToBounds="True">
                            <ScrollViewer x:Name="TemplateBoardScrollViewer"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          PreviewMouseDown="TemplateBoardSurface_MouseDown"
                                          PreviewMouseMove="TemplateBoardSurface_MouseMove"
                                          PreviewMouseUp="TemplateBoardSurface_MouseUp"
                                          PreviewMouseWheel="TemplateBoard_MouseWheel"
                                          AutomationProperties.AutomationId="TemplateBoardScrollViewer">
                                <Grid Width="2400" Height="1500">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform X="{Binding TemplateBoardPanX}" Y="{Binding TemplateBoardPanY}" />
                                            <ScaleTransform ScaleX="{Binding TemplateBoardZoom}" ScaleY="{Binding TemplateBoardZoom}" />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <ListBox ItemsSource="{Binding TemplatePages}"
                                             SelectedItem="{Binding SelectedTemplatePage, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             AllowDrop="False"
                                             PreviewMouseLeftButtonDown="TemplateBoardPage_MouseLeftButtonDown"
                                             PreviewMouseMove="TemplateBoardPage_MouseMove"
                                             PreviewMouseLeftButtonUp="TemplateBoardPage_MouseLeftButtonUp"
                                             AutomationProperties.AutomationId="TemplateBoardPageList">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="2400" Height="1500" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                                <Setter Property="FocusVisualStyle" Value="{StaticResource VisibleFocusStyle}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="300" Height="250" Margin="8" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="28" />
                                                            <RowDefinition Height="150" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Foreground="{StaticResource TextMutedBrush}" Text="{Binding ContentTypeText}" />
                                                        </Grid>
                                                        <Border Grid.Row="1" Background="{StaticResource SurfaceSubtleBrush}" CornerRadius="4">
                                                            <Image Source="{Binding PreviewSourceReference, Converter={StaticResource BoundedPreviewImageConverter}, ConverterParameter=500}" Stretch="Uniform" AutomationProperties.AutomationId="TemplateBoardPagePreview" />
                                                        </Border>
                                                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Text="{Binding CanvasSummary}" />
                                                            <TextBox Margin="0,4,0,0" Height="28" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="页面备注，可写素材规则或视角说明" AutomationProperties.AutomationId="TemplateBoardPageNotes" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
        
                 <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding CalibrationPageColumnWidth}" />
                        <ColumnDefinition Width="{Binding CalibrationPanelGapWidth}" />
                        <ColumnDefinition Width="{Binding CalibrationCanvasColumnWidth}" />
                        <ColumnDefinition Width="{Binding CalibrationPanelGapWidth}" />
                        <ColumnDefinition Width="{Binding CalibrationInspectorColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource SectionCardStyle}"
                            Padding="0"
                            Visibility="{Binding IsCalibrationPagePanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                         <Grid ClipToBounds="True">
                             <Grid.RowDefinitions>
                                 <RowDefinition Height="92" />
                                 <RowDefinition Height="220" />
                                 <RowDefinition Height="44" />
                                 <RowDefinition Height="*" />
                                 <RowDefinition Height="Auto" />
                             </Grid.RowDefinitions>
                              <Border Grid.Row="0"
                                      Padding="12,10"
                                      Background="{StaticResource SurfaceSubtleBrush}">
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="*" />
                                         <ColumnDefinition Width="Auto" />
                                     </Grid.ColumnDefinitions>
                                      <StackPanel VerticalAlignment="Center">
                                          <TextBlock FontSize="14"
                                                     FontWeight="Medium"
                                                     Text="{Binding CalibrationPageListTitle}" />
                                          <TextBlock Margin="0,3,0,0"
                                                     FontSize="11"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Text="{Binding ReferenceLearningOverallProgress}"
                                                     TextWrapping="Wrap"
                                                     Visibility="{Binding IsReferenceLearningReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     AutomationProperties.AutomationId="ReferenceLearningOverallProgress" />
                                          <TextBlock Margin="0,2,0,0"
                                                     FontSize="11"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Text="{Binding ReferenceLearningCurrentPageProgress}"
                                                     TextWrapping="Wrap"
                                                     Visibility="{Binding IsReferenceLearningReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     AutomationProperties.AutomationId="ReferenceLearningCurrentPageProgress" />
                                          <TextBlock Margin="0,2,0,0"
