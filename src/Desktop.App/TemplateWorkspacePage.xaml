                                         <TextBox Margin="0,0,6,0"
                                                  Style="{StaticResource FieldTextBoxStyle}"
                                                  ToolTip="水平偏移"
                                                  Text="{Binding CalibrationOffsetXInput, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.AutomationId="CalibrationOffsetXInput" />
                                         <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                                  ToolTip="垂直偏移"
                                                  Text="{Binding CalibrationOffsetYInput, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.AutomationId="CalibrationOffsetYInput" />
                                     </UniformGrid>
                                 </StackPanel>
                             </Expander>
                              <TextBlock Margin="0,16,0,7"
                                         FontSize="12"
                                         FontWeight="Medium"
                                         Text="图片框用途（未来选图规则，可修改）" />
                             <TextBlock Margin="0,0,0,7"
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="{Binding CalibrationRuleStatusText}"
                                        TextWrapping="Wrap"
                                        AutomationProperties.AutomationId="CalibrationRuleStatus" />
                             <TextBox MinHeight="58"
                                       IsEnabled="{Binding CanEditReferenceLearningRule}"
                                       Style="{StaticResource FieldTextBoxStyle}"
                                       ToolTip="需要时修正系统识别的用途，例如：正面全身图，商品主体完整"
                                      Text="{Binding CalibrationRequirementInput, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     InputMethod.IsInputMethodEnabled="True"
                                     AutomationProperties.AutomationId="CalibrationRequirementInput" />
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ApplyAndConfirmCalibrationCommand}"
                                    IsEnabled="{Binding CanApplyAndConfirmCalibration}"
                                    Content="应用并确认当前规则"
                                    AutomationProperties.AutomationId="ApplyAndConfirmCalibrationButton" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsReferenceLearningReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="ReferenceLearningReviewActions">
                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding ReferenceLearningQualifiedCandidateSummary}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="ReferenceLearningQualifiedCandidateSummary" />
                                 <Button Margin="0,10,0,0"
                                         Style="{StaticResource PrimaryButtonStyle}"
                                         Command="{Binding ConfirmReferenceLearningPageCommand}"
                                         IsEnabled="{Binding CanConfirmReferenceLearningPage}"
                                         Content="确认本页可直接采用的规则"
                                         AutomationProperties.AutomationId="ConfirmReferenceLearningPageButton" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ConfirmAllQualifiedReferenceLearningCommand}"
                                        IsEnabled="{Binding CanConfirmAllQualifiedReferenceLearning}"
                                         Content="确认全部可直接采用的规则"
                                         AutomationProperties.AutomationId="ConfirmAllQualifiedReferenceLearningButton" />
                                <Button Margin="0,8,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RejectReferenceLearningFrameCommand}"
                                        Content="保留模板内容，不替换"
                                        AutomationProperties.AutomationId="RejectReferenceLearningFrameButton" />
                                 <Button Margin="0,8,0,0"
                                         Style="{StaticResource GhostButtonStyle}"
                                         Command="{Binding ReturnReferenceLearningToManualCommand}"
                                         Content="改用拖拽校准"
                                         Visibility="{Binding IsReferenceLearningManualFallbackVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         AutomationProperties.AutomationId="ReturnReferenceLearningToManualButton" />
                            </StackPanel>
                            <TextBlock Margin="0,22,0,7"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Text="当前图片框素材"
                                       Visibility="{Binding IsManualCalibrationReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <ListBox MaxHeight="150"
                                     ItemsSource="{Binding CalibrationDraft.Assets}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     PreviewMouseLeftButtonDown="CalibrationAssetList_MouseLeftButtonDown"
                                     PreviewMouseMove="CalibrationAssetList_MouseMove"
                                     AutomationProperties.AutomationId="CalibrationAssetList"
                                     Visibility="{Binding IsManualCalibrationReviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                         </StackPanel>
                          </ScrollViewer>
                          </Grid>
                      </Border>
                      <Border Grid.Column="4"
                              Style="{StaticResource SectionCardStyle}"
                              Padding="16"
                              Visibility="{Binding IsSelectedDynamicSizeTable, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="DynamicSizeTableCanvasInspector">
                          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <StackPanel>
                              <TextBlock Style="{StaticResource PanelTitleTextStyle}" Text="动态尺码表页面" />
                              <TextBlock Margin="0,8,0,0"
                                         Style="{StaticResource SmallBodyTextStyle}"
                                         Foreground="{StaticResource TextMutedBrush}"
                                         Text="设置尺码表区域与样式，并选择要隐藏的旧表图层。"
                                         TextWrapping="Wrap" />
                              <TextBlock Margin="0,18,0,6" Style="{StaticResource FieldLabelTextStyle}" Text="页面名称" />
                              <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                       Text="{Binding SelectedTemplatePage.Name, UpdateSourceTrigger=PropertyChanged}"
                                       IsReadOnly="{Binding SelectedTemplatePage.IsReadOnly}" />
                              <TextBlock Margin="0,14,0,6" Style="{StaticResource FieldLabelTextStyle}" Text="生成方式" />
                              <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                        ItemsSource="{x:Static local:TemplatePageRowViewModel.GenerationModeOptions}"
                                        SelectedItem="{Binding SelectedTemplatePage.GenerationModeText, Mode=TwoWay}" />
                              <Button Content="设置尺码表区域与样式" Click="ConfigureSizeTable_Click" Margin="0,12,0,0"
                                      AutomationProperties.AutomationId="ConfigureSizeTableCalibration" />
                              <Border Margin="0,18,0,0" Padding="12" Background="{StaticResource InfoSurfaceBrush}" CornerRadius="6">
                                  <TextBlock Style="{StaticResource SmallBodyTextStyle}" Text="批次中的尺码数据会生成清晰表格并完整放入已设置的区域。尚未设置时会阻止渲染。" TextWrapping="Wrap" />
                              </Border>
                          </StackPanel>
                          </ScrollViewer>
                      </Border>
                         </Grid>
                 <Border Grid.Row="6"
                         Margin="0,12,0,0"
                         Padding="12,9"
                         Background="{StaticResource SurfaceSubtleBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="8"
                         AutomationProperties.AutomationId="CalibrationStatusBar">
                     <Grid>
                         <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="*" />
                             <ColumnDefinition Width="Auto" />
                         </Grid.ColumnDefinitions>
                         <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding CalibrationWorkflowStatusMessage}"
                                    TextTrimming="CharacterEllipsis" />
                         <TextBlock Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding CalibrationFooterMetaText}"
                                    TextTrimming="CharacterEllipsis" />
                     </Grid>
                 </Border>
             </Grid>
        </Grid>
        
        <local:TemplateConfirmationDialog />
        <local:DuplicateReviewDialog />
    </Grid>
</UserControl>
