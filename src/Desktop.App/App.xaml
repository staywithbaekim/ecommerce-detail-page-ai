<Application x:Class="Desktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Desktop.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <app:BoundedPreviewImageConverter x:Key="BoundedPreviewImageConverter" />
            <Style x:Key="AiStyleStatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusState}" Value="Analysing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="Ready"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="ReviewRequired"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="BudgetStopped"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="BusinessError"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="SystemError"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AiRequirementStatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Fill" Value="{StaticResource TextDisabledBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusState}" Value="Analysing"><Setter Property="Fill" Value="{StaticResource StatusAnalyzingBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="AiSelected"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="ManualLocked"><Setter Property="Fill" Value="{StaticResource StatusCompletedBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="ReviewRequired"><Setter Property="Fill" Value="{StaticResource StatusPausedBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="Unsafe"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="Missing"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding StatusState}" Value="Unavailable"><Setter Property="Fill" Value="{StaticResource StatusRecoverableBrush}" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
