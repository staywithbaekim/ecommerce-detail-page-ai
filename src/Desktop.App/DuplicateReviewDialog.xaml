<UserControl x:Class="Desktop.App.DuplicateReviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid>
        <Grid Grid.Row="0"
              Panel.ZIndex="20"
              Background="{StaticResource ModalOverlayBrush}"
              Visibility="{Binding IsDuplicateReviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.AutomationId="DuplicatePsdReviewDialog"
              AutomationProperties.Name="重复 PSD 确认"
              AutomationProperties.LiveSetting="Assertive">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogCardStyle}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="检测到内容相同的 PSD" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="系统不会自动删除任何源文件。请选择这次导入应如何处理："
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="{Binding DuplicateExistingLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="复用模板库中已经验证的应用内部副本。" />
                            <TextBlock Margin="0,14,0,0"
                                       FontWeight="Medium"
                                       Text="{Binding DuplicateImportedLabel}" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="保留本次复制，作为独立页面继续检查。" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,22,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CancelDuplicateCommand}"
                                Content="取消本次导入"
                                AutomationProperties.AutomationId="CancelDuplicateButton" />
                        <Button Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding KeepImportedDuplicateCommand}"
                                Content="保留本次导入"
                                AutomationProperties.AutomationId="KeepImportedDuplicateButton" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding KeepExistingDuplicateCommand}"
                                Content="复用已有副本"
                                AutomationProperties.AutomationId="ReuseExistingDuplicateButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</UserControl>
