<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Desktop.Application\Desktop.Application.csproj" />
    <ProjectReference Include="..\Desktop.Infrastructure\Desktop.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <Target Name="BuildPsdInspectionWorker" AfterTargets="Build" BeforeTargets="PrepareForPublish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\build-psd-inspection-worker.ps1&quot; -OutputDirectory &quot;$(TargetDir).&quot; -BuildDirectory &quot;$(MSBuildProjectDirectory)\obj\psd-inspection-worker\$(Configuration)&quot;" />
  </Target>

  <Target Name="CopyPsdInspectionWorkerToPublishDirectory" AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <ItemGroup>
      <PsdInspectionWorkerFile Include="$(TargetDir)psd-inspection-worker\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PsdInspectionWorkerFile)"
          DestinationFiles="@(PsdInspectionWorkerFile->'$(PublishDir)psd-inspection-worker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
